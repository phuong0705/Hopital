PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3011

DB_USER=your_sql_server_user
DB_PASSWORD=your_sql_server_password
DB_SERVER=your-server.database.windows.net
DB_NAME=your_database_name
DB_DATABASE=your_database_name
DB_PORT=1433
DB_AUTH=sql
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_WARMUP_ON_START=true

SESSION_SECRET=change_this_secret
REPORTS_FRONTEND_URL=http://localhost:3011/reports
REPORTS_FRONTEND_INTERNAL_URL=http://localhost:3011
NEXT_PUBLIC_HIS_URL=http://localhost:3003
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000

# Local SQL Server auth example:
# DB_SERVER=localhost
# DB_NAME=QuanLyKhamChuaBenhNoiTru
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true

# Local Windows auth example:
# DB_AUTH=windows
# DB_SERVER=localhost\SQLEXPRESS
# DB_DATABASE=QuanLyKhamChuaBenhNoiTru
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true
