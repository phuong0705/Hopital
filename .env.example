PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3011

DB_USER=your_sql_server_user
DB_PASSWORD=your_sql_server_password
DB_SERVER=your-server.database.windows.net
DB_NAME=your_database_name
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_SECRET=change_this_secret
REPORTS_FRONTEND_URL=http://localhost:3011/reports
REPORTS_FRONTEND_INTERNAL_URL=http://localhost:3011

# Local SQL Server auth example:
# DB_SERVER=localhost
# DB_NAME=QuanLyKhamChuaBenhNoiTru
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true
