{
  "name": "quan-ly-kham-chua-benh-noi-tru",
  "version": "1.0.0",
  "description": "He thong web quan li kham chua benh noi tru bang Node.js, Express, EJS va SQL Server",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node scripts/dev-runner.js",
    "dev:backend": "nodemon app.js",
    "reports:dev": "npm --prefix frontend run dev",
    "reports:build": "npm --prefix frontend run build",
    "db:test": "node scripts/db-test.js",
    "db:migrate:indexes": "node scripts/run-sql-file.js sql/migrations/add-performance-indexes.sql"
  },
  "keywords": [
    "hospital",
    "inpatient",
    "express",
    "ejs",
    "sql-server"
  ],
