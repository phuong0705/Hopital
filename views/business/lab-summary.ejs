<section class="module-hero">
  <div>
    <h2>Tổng hợp kết quả xét nghiệm</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-light" type="button" data-print-page><i class="bi bi-printer me-2"></i>In danh sách</button>
  </div>
</section>

<section class="panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm tên bệnh nhân hoặc mã xét nghiệm" data-module-search="labSummaryTable">
    </div>
    <select class="form-select w-auto" data-module-filter="labSummaryTable" data-filter-key="status">
      <option value="">Tất cả trạng thái</option>
      <option>Chờ lấy mẫu</option>
      <option>Đang thực hiện</option>
      <option>Đã có kết quả</option>
    </select>
  </div>

  <div class="table-responsive">
    <table class="table app-table" id="labSummaryTable">
      <thead>
        <tr>
          <th>Bệnh nhân</th>
          <th>Loại xét nghiệm</th>
          <th>Thời gian chỉ định</th>
          <th>Trạng thái</th>
          <th>Kết quả / Kết luận</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => { %>
          <tr data-search="<%= `${row.patientName} ${row.testType}`.toLowerCase() %>" data-status="<%= row.status %>">
            <td>
              <strong><%= row.patientName %></strong>
            </td>
            <td><strong><%= row.testType %></strong></td>
            <td><%= format.datetime(row.orderedDate) %></td>
            <td><%- include('../partials/badge', { text: row.status }) %></td>
            <td class="text-wrap-cell" style="max-width: 300px;">
              <% if (row.status === 'Đã có kết quả') { %>
                <div class="text-success"><%= row.resultSummary %></div>
              <% } else { %>
                <span class="text-muted italic">Đang chờ kết quả...</span>
              <% } %>
            </td>
            <td class="text-end">
              <div class="d-flex justify-content-end gap-1">
                <a href="/medical-records/<%= row.recordId %>" class="btn btn-sm btn-light" data-bs-toggle="tooltip" title="Xem hồ sơ bệnh án">
                  <i class="bi bi-journal-medical"></i>
                </a>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#updateResultModal" data-test-code="<%= row.testCode %>" data-status="<%= row.status %>" data-result="<%= row.resultSummary || '' %>">
                  <i class="bi bi-pencil-square"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!rows.length) { %>
          <tr>
            <td colspan="6" class="text-center py-4 text-muted">Chưa có chỉ định xét nghiệm nào</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<!-- Update Result Modal -->
<div class="modal fade" id="updateResultModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Nhập kết quả xét nghiệm</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="updateResultForm">
          <input type="hidden" id="testCodeInput" name="testCode">
          <div class="mb-3">
            <label class="form-label">Trạng thái</label>
            <select class="form-select" id="statusInput" name="status" required>
              <option value="Chờ lấy mẫu">Chờ lấy mẫu</option>
              <option value="Đang thực hiện">Đang thực hiện</option>
              <option value="Đã có kết quả">Đã có kết quả</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Kết quả / Kết luận</label>
            <textarea class="form-control" id="resultInput" name="resultSummary" rows="4" required></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-primary" id="saveResultBtn">Lưu kết quả</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const updateResultModal = document.getElementById('updateResultModal');
    if (updateResultModal) {
      updateResultModal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget;
        const testCode = button.getAttribute('data-test-code');
        const status = button.getAttribute('data-status');
        const result = button.getAttribute('data-result');

        document.getElementById('testCodeInput').value = testCode;
        document.getElementById('statusInput').value = status;
        document.getElementById('resultInput').value = result;
      });
    }

    const saveResultBtn = document.getElementById('saveResultBtn');
    if (saveResultBtn) {
      saveResultBtn.addEventListener('click', async () => {
        const form = document.getElementById('updateResultForm');
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const testCode = document.getElementById('testCodeInput').value;
        const status = document.getElementById('statusInput').value;
        const resultSummary = document.getElementById('resultInput').value;

        try {
          saveResultBtn.disabled = true;
          const response = await fetch(`/labtests/${testCode}/result`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ status, resultSummary })
          });

          const data = await response.json();
          if (response.ok) {
            window.location.reload();
          } else {
            alert(data.error || 'Có lỗi xảy ra');
          }
        } catch (err) {
          console.error(err);
          alert('Không thể kết nối đến máy chủ');
        } finally {
          saveResultBtn.disabled = false;
        }
      });
    }
  });
</script>
