<section class="module-hero">
  <div>
    <h2>Danh mục dịch vụ</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-light" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light" type="button" data-export-table="servicesTable" data-filename="danh-muc-dich-vu.csv"><i class="bi bi-filetype-csv me-2"></i>CSV</button>
    <% if (['ADMIN', 'RECEPTIONIST'].includes(currentUser.roleCode)) { %>
      <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#serviceModal">
        Thêm dịch vụ
      </button>    <% } %>
  </div>
</section>

<section class="panel module-panel mt-4">
  <div class="module-toolbar three">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm mã, tên dịch vụ, khoa thực hiện" data-module-search="servicesTable">
    </div>
    <select class="form-select" data-module-filter="servicesTable" data-filter-key="group">
      <option value="">Tất cả nhóm dịch vụ</option>
      <% [...new Set(rows.map(row => row.serviceGroup).filter(Boolean))].forEach(group => { %>
        <option value="<%= group %>"><%= group %></option>
      <% }) %>
    </select>
    <select class="form-select" data-module-filter="servicesTable" data-filter-key="status">
      <option value="">Tất cả trạng thái</option>
      <option value="Đang sử dụng">Đang sử dụng</option>
      <option value="Ngưng sử dụng">Ngưng sử dụng</option>
    </select>
  </div>

  <div class="module-table-wrap">
    <table class="table app-table module-table" id="servicesTable">
      <thead>
        <tr>
          <th></th>
          <th>Dịch vụ</th>
          <th>Nhóm</th>
          <th>Khoa thực hiện</th>
          <th>Đơn vị</th>
          <th>Đơn giá</th>
          <th>BHYT</th>
          <th>Thời gian</th>
          <th>Trạng thái</th>
          <th class="text-end no-export">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => {
          const statusClass = row.status === 'Đang sử dụng' ? 'status-success' : 'status-secondary';
        %>
          <tr
            data-search="<%= `${row.serviceCode} ${row.serviceName} ${row.serviceGroup} ${row.departmentName || ''} ${row.description || ''}`.toLowerCase() %>"
            data-group="<%= row.serviceGroup %>"
            data-status="<%= row.status %>">
            <td></td>
            <td>
              <div class="module-primary">
                <strong><%= row.serviceName %></strong>
                <small><%= row.description || 'Chưa cập nhật mô tả' %></small>
              </div>
            </td>
            <td><%= row.serviceGroup %></td>
            <td><%= row.departmentName || '-' %></td>
            <td><%= row.unit %></td>
            <td><strong><%= Number(row.unitPrice || 0).toLocaleString('vi-VN') %> đ</strong></td>
            <td><%= row.insuranceRate %>%</td>
            <td><%= row.turnaroundTime || '-' %></td>
            <td><span class="status-badge <%= statusClass %>"><%= row.status %></span></td>
            <td class="text-end no-export">
              <% if (['ADMIN', 'RECEPTIONIST'].includes(currentUser.roleCode)) { %>
                <form action="/nghiep-vu/danh-muc-dich-vu/<%= row.serviceId %>/status" method="post" class="d-inline">
                  <input type="hidden" name="status" value="<%= row.status === 'Đang sử dụng' ? 'Ngưng sử dụng' : 'Đang sử dụng' %>">
                  <button class="btn btn-sm btn-light action-icon" type="submit">
                    <i class="bi <%= row.status === 'Đang sử dụng' ? 'bi-lock' : 'bi-unlock' %>"></i>
                  </button>
                </form>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="empty-inline module-empty d-none" data-empty-for="servicesTable">
    <i class="bi bi-search"></i>
    <strong>Không tìm thấy dịch vụ phù hợp</strong>
  </div>
</section>

<% if (['ADMIN', 'RECEPTIONIST'].includes(currentUser.roleCode)) { %>
  <div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content app-modal">
        <div class="modal-header">
          <h5 class="modal-title">Thêm dịch vụ</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <form action="/nghiep-vu/danh-muc-dich-vu" method="post">
          <div class="modal-body">
            <div class="form-grid">
              <div><label class="form-label">Mã dịch vụ</label><input class="form-control" name="serviceCode" placeholder="DV006" required></div>
              <div><label class="form-label">Tên dịch vụ</label><input class="form-control" name="serviceName" placeholder="Siêu âm ổ bụng" required></div>
              <div><label class="form-label">Nhóm dịch vụ</label><input class="form-control" name="serviceGroup" placeholder="Chẩn đoán hình ảnh" required></div>
              <div><label class="form-label">Khoa thực hiện</label><input class="form-control" name="departmentName" placeholder="Chẩn đoán hình ảnh"></div>
              <div><label class="form-label">Đơn vị</label><input class="form-control" name="unit" value="lần"></div>
              <div><label class="form-label">Đơn giá</label><input class="form-control" name="unitPrice" type="number" min="0" value="0"></div>
              <div><label class="form-label">BHYT hỗ trợ (%)</label><input class="form-control" name="insuranceRate" type="number" min="0" max="100" value="0"></div>
              <div><label class="form-label">Thời gian trả kết quả</label><input class="form-control" name="turnaroundTime" placeholder="Trong ngày"></div>
              <div class="span-2"><label class="form-label">Mô tả</label><textarea class="form-control" name="description" rows="3"></textarea></div>
              <div><label class="form-label">Trạng thái</label><select class="form-select" name="status"><option selected>Đang sử dụng</option><option>Ngưng sử dụng</option></select></div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
            <button class="btn btn-primary" type="submit"><i class="bi bi-save me-2"></i>Lưu dịch vụ</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>
