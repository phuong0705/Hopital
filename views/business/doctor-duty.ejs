<section class="module-hero">
  <div>
    <h2>Phân công bác sĩ trực</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#dutyModal">Thêm phân công</button>
  </div>
</section>

<section class="panel mt-4">
  <div class="table-responsive">
    <table class="table app-table">
      <thead>
        <tr>
          <th>Bác sĩ</th>
          <th>Khoa công tác</th>
          <th>Chuyên khoa</th>
          <th>Ca trực hiện tại</th>
          <th>Bệnh nhân đang phụ trách</th>
          <th class="text-end">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (rows && rows.length) { %>
          <% rows.forEach(row => { %>
            <tr>
              <td><strong><%= row.fullName %></strong></td>
              <td><%= row.departmentName || 'Chưa gán khoa' %></td>
              <td><%= row.specialty || '-' %></td>
              <td><span class="badge bg-primary-soft text-primary"><%= row.shiftName || 'Chưa phân ca' %></span></td>
              <td><strong><%= row.activePatients %></strong> bệnh nhân</td>
              <td class="text-end">
                <div class="table-actions justify-content-end">
                  <button class="btn btn-sm btn-light action-icon" title="Đổi phân công"
                    type="button"
                    data-bs-toggle="modal" data-bs-target="#dutyModal"
                    data-id="<%= row.doctorId %>"
                    data-name="<%= row.fullName %>"
                    data-dept="<%= row.departmentId || '' %>"
                    data-shift="<%= row.shiftName || '' %>">
                    <i class="bi bi-arrow-repeat"></i>
                  </button>
                  <button class="btn btn-sm btn-light text-danger action-icon" title="Gỡ phân công"
                    type="button"
                    data-bs-toggle="modal" data-bs-target="#removeDutyModal"
                    data-id="<%= row.doctorId %>"
                    data-name="<%= row.fullName %>">
                    <i class="bi bi-person-x"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có bác sĩ trong danh mục.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<div class="modal fade" id="dutyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content app-modal">
      <form id="dutyForm" method="post" action="/nghiep-vu/quan-ly-bac-si-truc/new">
        <div class="modal-header">
          <h5 class="modal-title" id="dutyModalTitle">Phân công trực mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3" id="doctorSelectWrapper">
            <label class="form-label">Bác sĩ</label>
            <select id="dutyDoctorSelect" class="form-select" name="doctorId" required>
              <option value="" disabled selected>-- Chọn bác sĩ --</option>
              <% allDoctors.forEach(doctor => { %>
                <option value="<%= doctor.doctorId %>"><%= doctor.fullName %> - <%= doctor.specialty || 'Bác sĩ' %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3 d-none" id="doctorNameWrapper">
            <label class="form-label">Bác sĩ</label>
            <input id="dutyDoctorNameDisplay" class="form-control" disabled>
          </div>
          <div class="mb-3">
            <label class="form-label">Khoa trực</label>
            <select id="dutyDeptSelect" class="form-select" name="departmentId" required>
              <option value="" disabled selected>-- Chọn khoa --</option>
              <% departments.forEach(department => { %>
                <option value="<%= department.departmentId %>"><%= department.departmentName %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Ca trực</label>
            <select id="dutyShiftSelect" class="form-select" name="shiftName" required>
              <option value="Ca Sáng">Ca Sáng</option>
              <option value="Ca Chiều">Ca Chiều</option>
              <option value="Ca Đêm">Ca Đêm</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary">Lưu phân công</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="removeDutyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content app-modal">
      <form id="removeDutyForm" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Gỡ phân công</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body text-center py-4">
          <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
          <p>Bạn có chắc chắn muốn gỡ phân công trực cho bác sĩ <strong id="removeDoctorName"></strong>?</p>
          <p class="text-muted small">Thông tin về khoa và ca trực sẽ bị xóa.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-danger">Xác nhận gỡ</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dutyModal = document.getElementById('dutyModal');
    dutyModal?.addEventListener('show.bs.modal', (event) => {
      const button = event.relatedTarget;
      const id = button?.getAttribute('data-id');
      const name = button?.getAttribute('data-name');
      const dept = button?.getAttribute('data-dept') || '';
      const shift = button?.getAttribute('data-shift') || 'Ca Sáng';

      const form = document.getElementById('dutyForm');
      const title = document.getElementById('dutyModalTitle');
      const selectWrapper = document.getElementById('doctorSelectWrapper');
      const nameWrapper = document.getElementById('doctorNameWrapper');
      const nameDisplay = document.getElementById('dutyDoctorNameDisplay');
      const doctorSelect = document.getElementById('dutyDoctorSelect');
      const deptSelect = document.getElementById('dutyDeptSelect');
      const shiftSelect = document.getElementById('dutyShiftSelect');

      if (id) {
        form.action = '/nghiep-vu/quan-ly-bac-si-truc/' + id;
        title.textContent = 'Cập nhật phân công';
        selectWrapper.classList.add('d-none');
        nameWrapper.classList.remove('d-none');
        doctorSelect.removeAttribute('name');
        doctorSelect.required = false;
        nameDisplay.value = name;
        deptSelect.value = dept;
        shiftSelect.value = shift;
      } else {
        form.action = '/nghiep-vu/quan-ly-bac-si-truc/new';
        title.textContent = 'Phân công trực mới';
        selectWrapper.classList.remove('d-none');
        nameWrapper.classList.add('d-none');
        doctorSelect.setAttribute('name', 'doctorId');
        doctorSelect.required = true;
        doctorSelect.value = '';
        deptSelect.value = '';
        shiftSelect.value = 'Ca Sáng';
      }
    });

    const removeModal = document.getElementById('removeDutyModal');
    removeModal?.addEventListener('show.bs.modal', (event) => {
      const button = event.relatedTarget;
      const id = button.getAttribute('data-id');
      const name = button.getAttribute('data-name');

      document.getElementById('removeDutyForm').action = '/nghiep-vu/quan-ly-bac-si-truc/' + id + '/delete';
      document.getElementById('removeDoctorName').textContent = name;
    });
  });
</script>
