<section class="module-hero">
  <div>
    <h2>Sao lưu dữ liệu hệ thống</h2>
  </div>
</section>

<div class="row g-4 mt-2">
  <div class="col-lg-4">
    <div class="panel h-100">
      <div class="panel-header"><h2>Lệnh sao lưu</h2></div>
      <form action="/nghiep-vu/sao-luu-du-lieu" method="post" class="py-4">
        <div class="text-center">
          <i class="bi bi-cloud-arrow-up text-primary display-1 mb-4"></i>
          <p>Bản sao lưu gần nhất:<br>
            <strong><%= rows && rows.length ? format.datetime(rows[0].createdAt) : 'Chưa có dữ liệu' %></strong>
          </p>
        </div>
        <div class="mb-3">
          <label class="form-label">Phạm vi sao lưu</label>
          <select class="form-select" name="backupScope">
            <option>Dữ liệu nghiệp vụ</option>
            <option>Danh mục hệ thống</option>
            <option>Toàn bộ dữ liệu</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Ghi chú</label>
          <textarea class="form-control" name="note" rows="2"></textarea>
        </div>
        <button class="btn btn-primary btn-lg w-100" type="submit">
          <i class="bi bi-play-fill me-2"></i>Bắt đầu sao lưu
        </button>
      </form>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="panel">
      <div class="panel-header"><h2>Lịch sử sao lưu</h2></div>
      <div class="table-responsive mt-3">
        <table class="table app-table">
          <thead>
            <tr>
              <th>Mã sao lưu</th>
              <th>Tên bản sao lưu</th>
              <th>Phạm vi</th>
              <th>Ngày tạo</th>
              <th>Người tạo</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% if (rows && rows.length) { %>
              <% rows.forEach(row => { %>
                <tr>
                  <td><strong><%= row.backupCode %></strong></td>
                  <td><%= row.backupName %></td>
                  <td><%= row.backupScope %></td>
                  <td><%= format.datetime(row.createdAt) %></td>
                  <td><%= row.requestedBy || 'Hệ thống' %></td>
                  <td><%- include('../partials/badge', { text: row.status }) %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có yêu cầu sao lưu nào.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
