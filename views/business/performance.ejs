<section class="module-hero">
  <div>
    <h2>Theo dõi hiệu suất nhân sự</h2>
  </div>
</section>

<div class="row g-4 mt-2">
  <% rows.slice(0, 3).forEach(row => { %>
    <div class="col-md-4">
      <div class="panel text-center">
        <div class="avatar avatar-lg mx-auto mb-3"><%= row.fullName.charAt(0) %></div>
        <h5><%= row.fullName %></h5>
        <p class="text-muted small"><%= row.roleName %></p>
        <div class="mt-3">
          <span class="display-6 fw-bold text-primary"><%= row.totalTasks %></span><br>
          <small class="text-muted">Công việc hoàn thành (30 ngày qua)</small>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<section class="panel mt-4">
  <div class="panel-header"><h2>Chi tiết hiệu suất</h2></div>
  <div class="table-responsive mt-3">
    <table class="table app-table">
      <thead>
        <tr>
          <th>Nhân viên</th>
          <th>Chức vụ</th>
          <th>Tổng hồ sơ xử lý</th>
          <th>Trạng thái</th>
          <th>Xếp hạng</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => { %>
          <tr>
            <td><strong><%= row.fullName %></strong></td>
            <td><%= row.roleName %></td>
            <td><strong><%= row.totalTasks %></strong> hồ sơ</td>
            <td><span class="badge bg-success-soft text-success"><%= row.status %></span></td>
            <td>
              <% if (row.totalTasks > 10) { %>
                <i class="bi bi-star-fill text-warning"></i> 
                <i class="bi bi-star-fill text-warning"></i>
                <i class="bi bi-star-fill text-warning"></i>
              <% } else if (row.totalTasks > 5) { %>
                <i class="bi bi-star-fill text-warning"></i>
                <i class="bi bi-star-fill text-warning"></i>
              <% } else { %>
                <i class="bi bi-star-fill text-warning"></i>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
