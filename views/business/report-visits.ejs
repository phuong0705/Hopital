<section class="module-hero">
  <div>
    <h2>Thống kê lượt khám bệnh</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-light" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light" type="button" data-export-table="visitsTable" data-filename="thong-ke-luot-kham.csv">
      <i class="bi bi-file-earmark-spreadsheet me-2"></i>Excel
    </button>
  </div>
</section>

<section class="panel mt-4">
  <form class="patient-filter-form compact mb-4" method="get">
    <div class="d-flex align-items-center gap-2">
      <label class="text-nowrap small fw-bold">Từ ngày:</label>
      <input type="date" name="startDate" class="form-control" value="<%= filters.startDate || '' %>">
    </div>
    <div class="d-flex align-items-center gap-2">
      <label class="text-nowrap small fw-bold">Đến ngày:</label>
      <input type="date" name="endDate" class="form-control" value="<%= filters.endDate || '' %>">
    </div>
    <button class="btn btn-dark" type="submit"><i class="bi bi-funnel me-2"></i>Lọc</button>
    <% if (filters.startDate || filters.endDate) { %>
      <a class="btn btn-light" href="/nghiep-vu/thong-ke-luot-kham"><i class="bi bi-x-circle me-2"></i>Bỏ lọc</a>
    <% } %>
  </form>

  <div class="panel-header"><h2>Dữ liệu chi tiết</h2></div>
  <div class="table-responsive mt-3">
    <table class="table app-table" id="visitsTable">
      <thead>
        <tr>
          <th>Ngày</th>
          <th>Số lượt khám</th>
          <th class="no-export">Xu hướng</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((row, index) => { 
          const prev = rows[index + 1] ? rows[index + 1].visitCount : row.visitCount;
          const trend = row.visitCount >= prev ? 'bi-caret-up-fill text-success' : 'bi-caret-down-fill text-danger';
        %>
          <tr>
            <td><strong><%= format.date(row.date) %></strong></td>
            <td><span class="badge bg-light text-dark fs-6 px-3"><%= row.visitCount %> lượt</span></td>
            <td class="no-export"><i class="bi <%= trend %> me-1"></i> <%= Math.abs(row.visitCount - prev) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
