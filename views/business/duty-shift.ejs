<section class="module-hero">
  <div>
    <h2>Quản lý ca trực hệ thống</h2>
  </div>
  <div class="module-actions">
    <a class="btn btn-primary" href="/nghiep-vu/quan-ly-bac-si-truc"><i class="bi bi-person-check me-2"></i>Phân công bác sĩ</a>
  </div>
</section>

<div class="row g-4 mt-2">
  <div class="col-lg-4">
    <div class="panel h-100">
      <div class="panel-header"><h2>Các ca đang sử dụng</h2></div>
      <div class="list-group list-group-flush mt-3">
        <% if (shiftStats && shiftStats.length) { %>
          <% shiftStats.forEach(row => { %>
            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
              <div>
                <strong><%= row.shiftName %></strong><br>
                <small class="text-muted"><%= row.doctorCount %> bác sĩ · <%= row.activePatients || 0 %> bệnh nhân</small>
              </div>
              <span class="badge <%= row.unassignedDepartmentCount ? 'bg-warning text-dark' : 'bg-success' %>">
                <%= row.unassignedDepartmentCount ? 'Cần rà soát' : 'Đang áp dụng' %>
              </span>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-4 text-muted">Chưa có dữ liệu ca trực.</div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="panel">
      <div class="panel-header"><h2>Nhân sự theo ca</h2></div>
      <div class="table-responsive mt-3">
        <table class="table app-table">
          <thead>
            <tr>
              <th>Bác sĩ</th>
              <th>Khoa</th>
              <th>Ca trực</th>
              <th>Bệnh nhân phụ trách</th>
            </tr>
          </thead>
          <tbody>
            <% if (rows && rows.length) { %>
              <% rows.forEach(row => { %>
                <tr>
                  <td><strong><%= row.fullName %></strong></td>
                  <td><%= row.departmentName || 'Chưa gán khoa' %></td>
                  <td><span class="badge bg-primary-soft text-primary"><%= row.shiftName || 'Chưa phân ca' %></span></td>
                  <td><%= row.activePatients %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có bác sĩ trong danh mục.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
