<section class="module-hero">
  <div>
    <h2>Tiếp nhận & khám bệnh</h2>
  </div>
</section>

<section class="panel mt-4">
  <div class="panel-header">
    <div>
      <h2>Lịch hẹn cần khám</h2>
      <p>Tiếp nhận bệnh nhân theo lịch hẹn, mở hồ sơ để khám và đánh dấu hoàn tất khám.</p>
    </div>
  </div>

  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm mã hẹn, bệnh nhân hoặc lý do" data-module-search="doctorReceptionAppointmentsTable">
    </div>
    <select class="form-select w-auto" data-module-filter="doctorReceptionAppointmentsTable" data-filter-key="status">
      <option value="">Tất cả trạng thái</option>
      <option>Chưa khám</option>
      <option>Đã khám</option>
      <option>Đã tiếp nhận</option>
    </select>
  </div>

  <div class="module-table-wrap">
    <table class="table app-table module-table" id="doctorReceptionAppointmentsTable">
      <thead>
        <tr>
          <th>Thời gian</th>
          <th>Mã hẹn</th>
          <th>Bệnh nhân</th>
          <th>Lý do khám</th>
          <th>Trạng thái</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% appointments.forEach(row => { %>
          <tr data-search="<%= `${row.appointmentCode} ${row.patientCode} ${row.patientName} ${row.reason || ''}`.toLowerCase() %>" data-status="<%= row.status %>">
            <td><strong class="text-primary"><%= format.datetime(row.appointmentTime) %></strong></td>
            <td><code><%= row.appointmentCode %></code></td>
            <td>
              <strong><%= row.patientName %></strong>
              <small class="d-block text-muted"><%= row.patientCode %> · <%= row.phone || 'Không có SĐT' %></small>
            </td>
            <td class="text-wrap-cell compact"><%= row.reason || 'Khám theo lịch hẹn' %></td>
            <td><%- include('../partials/badge', { text: row.status }) %></td>
            <td class="text-end">
              <div class="d-flex justify-content-end gap-1">
                <% if (row.status !== 'Đã khám') { %>
                  <a href="/patients/<%= row.patientId %>?activeMenu=doctor-reception-exam" class="btn btn-sm btn-light">
                    <i class="bi bi-activity me-1"></i>Khám bệnh
                  </a>
                <% } %>
                <form action="/nghiep-vu/lich-hen-kham-hom-nay/<%= row.appointmentId %>/status" method="post" class="d-inline">
                  <input type="hidden" name="status" value="Đã khám">
                  <input type="hidden" name="returnTo" value="/nghiep-vu/tiep-nhan-kham-benh?activeMenu=doctor-reception-exam">
                  <button class="btn btn-sm <%= row.status === 'Đã khám' ? 'btn-success' : 'btn-light' %>" type="submit">
                    Đã khám
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!appointments.length) { %>
          <tr><td colspan="6" class="text-center py-4 text-muted">Không có lịch hẹn cần xử lý.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
