<section class="module-hero">
  <div>
    <h2>Tính phí khám bệnh</h2>
    <p class="text-muted">Tính toán và áp mã phí cho các lượt khám ngoại trú và xét nghiệm</p>
  </div>
  <div class="module-actions">
    <a href="/billing" class="btn btn-primary"><i class="bi bi-receipt me-2"></i>Lập phiếu thu</a>
  </div>
</section>

<section class="panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm bệnh nhân..." data-module-search="feeTable">
    </div>
  </div>

  <div class="table-responsive">
    <table class="table app-table" id="feeTable">
      <thead>
        <tr>
          <th>Mã BN</th>
          <th>Bệnh nhân</th>
          <th>Khoa chỉ định</th>
          <th>Nội dung khám</th>
          <th>Phí tạm tính</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% patients.filter(p => p.status === 'Đang điều trị').forEach(p => { %>
          <tr data-search="<%= `${p.patientCode} ${p.fullName}`.toLowerCase() %>">
            <td><span class="patient-code-pill"><%= p.patientCode %></span></td>
            <td><strong><%= p.fullName %></strong></td>
            <td><%= p.departmentName || 'Phòng khám chung' %></td>
            <td><%= p.initialDiagnosis || 'Khám tổng quát' %></td>
            <td><strong class="text-primary">150.000 đ</strong></td>
            <td class="text-end">
              <a href="/patients/<%= p.patientId %>" class="btn btn-sm btn-light" data-bs-toggle="tooltip" title="Xem chi tiết bệnh nhân">
                <i class="bi bi-eye"></i>
              </a>
              <a href="/billing?admissionId=<%= p.admissionId %>" class="btn btn-sm btn-primary">Tính phí</a>
            </td>
          </tr>
        <% }) %>
        <% if (!patients.length) { %>
          <tr><td colspan="6" class="text-center py-4 text-muted">Không có dữ liệu chờ tính phí</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
