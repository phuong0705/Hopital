<section class="module-hero">
  <div>
    <h2>Quản lý vật tư tiêu hao</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-light" type="button" data-bs-toggle="modal" data-bs-target="#requestSupplyModal"><i class="bi bi-cart-plus me-2"></i>Lĩnh vật tư</button>
  </div>
</section>

<section class="panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm tên hoặc mã vật tư" data-module-search="suppliesTable">
    </div>
  </div>

  <div class="module-table-wrap">
    <table class="table app-table module-table" id="suppliesTable">
      <thead>
        <tr>
          <th>Mã vật tư</th>
          <th>Tên vật tư</th>
          <th>Đơn vị</th>
          <th>Tồn kho khoa</th>
          <th>Định mức</th>
          <th>Cảnh báo</th>
          <th class="text-end">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (rows && rows.length) { %>
          <% rows.forEach(row => { %>
            <% const badgeClass = row.warningStatus === 'Ổn định' ? 'bg-success' : row.warningStatus === 'Sắp hết' || row.warningStatus === 'Hết hàng' ? 'bg-danger' : 'bg-warning text-dark'; %>
            <tr data-search="<%= `${row.supplyCode} ${row.supplyName}`.toLowerCase() %>">
              <td><strong><%= row.supplyCode %></strong></td>
              <td><%= row.supplyName %></td>
              <td><%= row.unit %></td>
              <td><strong class="<%= row.currentStock < row.stockNorm ? 'text-danger' : 'text-primary' %>"><%= row.currentStock %></strong></td>
              <td><%= row.stockNorm %></td>
              <td><span class="badge <%= badgeClass %>"><%= row.warningStatus %></span></td>
              <td class="text-end">
                <form action="/nghiep-vu/vat-tu-tieu-hao/transaction" method="post" class="d-inline">
                  <input type="hidden" name="supplyId" value="<%= row.supplyId %>">
                  <input type="hidden" name="transactionType" value="Xuất sử dụng">
                  <input type="hidden" name="quantity" value="1">
                  <button class="btn btn-sm btn-light" type="submit">Xuất 1 <%= row.unit %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có danh mục vật tư.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<div class="modal fade" id="requestSupplyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content app-modal">
      <form action="/nghiep-vu/vat-tu-tieu-hao/transaction" method="post">
        <input type="hidden" name="transactionType" value="Yêu cầu lĩnh">
        <div class="modal-header">
          <h5 class="modal-title">Lĩnh vật tư y tế</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Vật tư cần lĩnh</label>
            <select class="form-select" name="supplyId" required>
              <option value="" disabled selected>-- Chọn vật tư --</option>
              <% rows.forEach(row => { %>
                <option value="<%= row.supplyId %>"><%= row.supplyName %> (<%= row.supplyCode %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Số lượng yêu cầu</label>
            <input type="number" class="form-control" name="quantity" value="100" min="1" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Ghi chú</label>
            <textarea class="form-control" name="note" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary">Gửi yêu cầu</button>
        </div>
      </form>
    </div>
  </div>
</div>
