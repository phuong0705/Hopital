<% const canManageFormTemplates = currentUser && currentUser.roleCode === 'ADMIN'; %>

<section class="module-hero">
  <div>
    <h2>Danh mục biểu mẫu</h2>
  </div>
  <div class="module-actions">
    <% if (canManageFormTemplates) { %>
      <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createFormTemplateModal">
        <i class="bi bi-file-earmark-plus me-2"></i>Thêm biểu mẫu
      </button>
    <% } %>
    <button class="btn btn-light" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light" type="button" data-export-table="formTemplatesTable" data-filename="danh-muc-bieu-mau.csv"><i class="bi bi-filetype-csv me-2"></i>CSV</button>
  </div>
</section>

<section class="panel module-panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm mã, tên, nhóm biểu mẫu" data-module-search="formTemplatesTable">
    </div>
    <select class="form-select" data-module-filter="formTemplatesTable" data-filter-key="type">
      <option value="">Tất cả nhóm biểu mẫu</option>
      <% [...new Set(rows.map(row => row.templateType))].filter(Boolean).forEach(type => { %>
        <option><%= type %></option>
      <% }) %>
    </select>
  </div>

  <div class="module-table-wrap">
    <table class="table app-table module-table" id="formTemplatesTable">
      <thead>
        <tr>
          <th>Mã biểu mẫu</th>
          <th>Tên biểu mẫu</th>
          <th>Nhóm</th>
          <th>Mô tả</th>
          <th>Trạng thái</th>
          <th class="text-end no-export">Tệp</th>
          <% if (canManageFormTemplates) { %>
            <th class="text-end no-export">Thao tác</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => { %>
          <tr data-search="<%= `${row.templateCode} ${row.templateName} ${row.templateType} ${row.description || ''}`.toLowerCase() %>" data-type="<%= row.templateType %>">
            <td><strong><%= row.templateCode %></strong></td>
            <td><%= row.templateName %></td>
            <td><span class="module-soft-pill"><%= row.templateType %></span></td>
            <td class="text-wrap-cell"><%= row.description || '-' %></td>
            <td><%- include('../partials/badge', { text: row.status }) %></td>
            <td class="text-end no-export">
              <% if (row.fileUrl) { %>
                <a class="btn btn-sm btn-light action-icon" href="<%= row.fileUrl %>" target="_blank" data-bs-toggle="tooltip" title="Mở PDF">
                  <i class="bi bi-file-earmark-text"></i>
                </a>
                <% if (row.originalFileUrl && row.originalFileUrl !== row.fileUrl) { %>
                  <a class="btn btn-sm btn-light action-icon" href="<%= row.originalFileUrl %>" target="_blank" data-bs-toggle="tooltip" title="Mở file Word gốc">
                    <i class="bi bi-file-earmark-word"></i>
                  </a>
                <% } %>
              <% } else { %>
                <span class="text-muted small">Chưa có tệp</span>
              <% } %>
            </td>
            <% if (canManageFormTemplates) { %>
              <td class="text-end no-export">
                <form action="/nghiep-vu/bieu-mau/<%= row.templateId %>/status" method="post" class="d-inline">
                  <% const isLocked = row.status === 'Khóa'; %>
                  <input type="hidden" name="status" value="<%= isLocked ? 'Đang sử dụng' : 'Khóa' %>">
                  <button
                    class="btn btn-sm <%= isLocked ? 'btn-light' : 'btn-light text-danger' %> action-icon action-icon-xs"
                    type="submit"
                    data-bs-toggle="tooltip"
                    title="<%= isLocked ? 'Mở khóa biểu mẫu' : 'Khóa biểu mẫu' %>"
                    aria-label="<%= isLocked ? 'Mở khóa biểu mẫu' : 'Khóa biểu mẫu' %>">
                    <i class="bi <%= isLocked ? 'bi-unlock' : 'bi-lock' %>"></i>
                  </button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }) %>
        <% if (!rows.length) { %>
          <tr>
            <td colspan="<%= canManageFormTemplates ? 7 : 6 %>" class="text-center py-4 text-muted">Chưa có biểu mẫu nào trong danh mục.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="empty-inline module-empty d-none" data-empty-for="formTemplatesTable">
    <i class="bi bi-search"></i>
    <strong>Không tìm thấy biểu mẫu phù hợp</strong>
  </div>
</section>

<% if (canManageFormTemplates) { %>
  <div class="modal fade" id="createFormTemplateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content app-modal">
        <form action="/nghiep-vu/bieu-mau" method="post" enctype="multipart/form-data">
          <div class="modal-header">
            <h5 class="modal-title">Thêm biểu mẫu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Mã biểu mẫu</label>
                <input type="text" name="templateCode" class="form-control" placeholder="VD: BM-NT-20" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Nhóm biểu mẫu</label>
                <input type="text" name="templateType" class="form-control" placeholder="VD: Điều trị nội trú" required>
              </div>
              <div class="col-12">
                <label class="form-label">Tên biểu mẫu</label>
                <input type="text" name="templateName" class="form-control" required>
              </div>
              <div class="col-12">
                <label class="form-label">File biểu mẫu</label>
                <input type="file" name="templateFile" class="form-control" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required>
                <small class="text-muted">Hỗ trợ PDF, DOC, DOCX. File Word sẽ tự chuyển sang PDF nếu máy chủ có LibreOffice.</small>
              </div>
              <div class="col-12">
                <label class="form-label">Mô tả</label>
                <textarea name="description" class="form-control" rows="3"></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Lưu biểu mẫu</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>
