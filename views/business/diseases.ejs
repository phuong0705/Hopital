<section class="module-hero">
  <div>
    <h2>Tra cứu bệnh, triệu chứng và thuốc tham khảo</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-light" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light" type="button" data-export-table="diseasesTable" data-filename="thu-vien-benh.csv"><i class="bi bi-filetype-csv me-2"></i>CSV</button>
    <% if (['ADMIN', 'DOCTOR'].includes(currentUser.roleCode)) { %>
      <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#diseaseModal">
        Thêm bệnh
      </button>
    <% } %>
  </div>
</section>

<section class="panel module-panel mt-4">
  <div class="module-toolbar three">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm bệnh, triệu chứng, thuốc, ICD-10" data-module-search="diseasesTable">
    </div>
    <select class="form-select" data-module-filter="diseasesTable" data-filter-key="severity">
      <option value="">Tất cả mức độ</option>
      <option value="Thấp">Thấp</option>
      <option value="Trung bình">Trung bình</option>
      <option value="Cao">Cao</option>
      <option value="Nguy cấp">Nguy cấp</option>
    </select>
    <select class="form-select" data-module-filter="diseasesTable" data-filter-key="specialty">
      <option value="">Tất cả chuyên khoa</option>
      <% [...new Set(rows.map(row => row.specialty).filter(Boolean))].forEach(specialty => { %>
        <option value="<%= specialty %>"><%= specialty %></option>
      <% }) %>
    </select>
  </div>

  <div class="disease-library-grid">
    <% rows.forEach(row => {
      const severityClass = row.severityLevel === 'Nguy cấp' || row.severityLevel === 'Cao'
        ? 'status-danger'
        : (row.severityLevel === 'Trung bình' ? 'status-warning' : 'status-success');
      const searchText = [
        row.diseaseCode,
        row.icd10Code,
        row.diseaseName,
        row.specialty,
        row.commonSymptoms,
        row.suggestedTests,
        row.recommendedMedicines,
        row.clinicalGuidance,
        row.contraindications,
        row.description
      ].join(' ').toLowerCase();
    %>
      <article
        class="disease-card"
        data-table-row="diseasesTable"
        data-search="<%= searchText %>"
        data-severity="<%= row.severityLevel %>"
        data-specialty="<%= row.specialty %>">
        <div class="disease-card-head">
          <span class="disease-icon-box"><i class="bi bi-virus"></i></span>
          <span class="status-badge status-info"><%= row.icd10Code %></span>
        </div>
        <h3><%= row.diseaseName %></h3>
        <div class="disease-meta">
          <span><i class="bi bi-hospital"></i> <%= row.specialty %></span>
        </div>
        <div class="disease-preview">
          <strong>Triệu chứng thường gặp</strong>
          <p><%= row.commonSymptoms || row.description || 'Chưa cập nhật triệu chứng.' %></p>
        </div>
        <div class="disease-preview medicine">
          <strong>Thuốc gợi ý</strong>
          <p><%= row.recommendedMedicines || 'Chưa có gợi ý thuốc.' %></p>
        </div>
        <div class="disease-card-actions">
          <button class="btn btn-light btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#diseaseDetail<%= row.diseaseId %>">
            <i class="bi bi-eye me-2"></i>Xem chi tiết
          </button>
          <% if (['ADMIN', 'DOCTOR'].includes(currentUser.roleCode)) { %>
            <form action="/nghiep-vu/danh-muc-benh/<%= row.diseaseId %>/status" method="post">
              <input type="hidden" name="status" value="<%= row.status === 'Đang sử dụng' ? 'Ngưng sử dụng' : 'Đang sử dụng' %>">
              <button class="btn btn-sm btn-light action-icon" type="submit" data-bs-toggle="tooltip" data-bs-title="<%= row.status === 'Đang sử dụng' ? 'Ngưng sử dụng' : 'Kích hoạt' %>">
                <i class="bi <%= row.status === 'Đang sử dụng' ? 'bi-lock' : 'bi-unlock' %>"></i>
              </button>
            </form>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>

  <table class="d-none" id="diseasesTable">
    <thead>
      <tr>
        <th>Mã bệnh</th>
        <th>ICD-10</th>
        <th>Tên bệnh</th>
        <th>Chuyên khoa</th>
        <th>Mức độ</th>
        <th>Triệu chứng</th>
        <th>Thuốc gợi ý</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(row => { %>
        <tr data-search="<%= [
          row.diseaseCode,
          row.icd10Code,
          row.diseaseName,
          row.specialty,
          row.commonSymptoms,
          row.recommendedMedicines
        ].join(' ').toLowerCase() %>" data-severity="<%= row.severityLevel %>" data-specialty="<%= row.specialty %>">
          <td></td>
          <td><%= row.icd10Code %></td>
          <td><%= row.diseaseName %></td>
          <td><%= row.specialty %></td>
          <td><%= row.severityLevel %></td>
          <td><%= row.commonSymptoms || '' %></td>
          <td><%= row.recommendedMedicines || '' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="empty-inline module-empty d-none" data-empty-for="diseasesTable">
    <i class="bi bi-search"></i>
    <strong>Không tìm thấy bệnh phù hợp</strong>
  </div>
</section>

<% rows.forEach(row => { %>
  <div class="modal fade" id="diseaseDetail<%= row.diseaseId %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content app-modal disease-detail-modal">
        <div class="modal-header">
          <div>
            <span class="module-code">ICD-10 <%= row.icd10Code %></span>
            <h5 class="modal-title"><%= row.diseaseName %></h5>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body">
          <div class="disease-detail-grid">
            <section class="disease-detail-block">
              <i class="bi bi-activity"></i>
              <h6>Triệu chứng thường gặp</h6>
              <p><%= row.commonSymptoms || 'Chưa cập nhật.' %></p>
            </section>
            <section class="disease-detail-block">
              <i class="bi bi-clipboard2-pulse"></i>
              <h6>Xét nghiệm/cận lâm sàng gợi ý</h6>
              <p><%= row.suggestedTests || 'Chưa cập nhật.' %></p>
            </section>
            <section class="disease-detail-block">
              <i class="bi bi-capsule-pill"></i>
              <h6>Thuốc có thể cân nhắc</h6>
              <p><%= row.recommendedMedicines || 'Chưa cập nhật.' %></p>
            </section>
            <section class="disease-detail-block">
              <i class="bi bi-journal-medical"></i>
              <h6>Hướng xử trí/thực hành lâm sàng</h6>
              <p><%= row.clinicalGuidance || row.description || 'Chưa cập nhật.' %></p>
            </section>
            <section class="disease-detail-block warning">
              <i class="bi bi-exclamation-triangle"></i>
              <h6>Lưu ý chống chỉ định/thận trọng</h6>
              <p><%= row.contraindications || 'Cần khai thác dị ứng thuốc, bệnh nền, thai kỳ, chức năng gan thận trước khi dùng thuốc.' %></p>
            </section>
          </div>
        </div>
        <div class="modal-footer">
          <span class="disease-disclaimer">Gợi ý thuốc chỉ để tham khảo, bác sĩ chịu trách nhiệm quyết định kê đơn theo người bệnh cụ thể.</span>
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
        </div>
      </div>
    </div>
  </div>
<% }) %>

<% if (['ADMIN', 'DOCTOR'].includes(currentUser.roleCode)) { %>
  <div class="modal fade" id="diseaseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content app-modal">
        <div class="modal-header">
          <h5 class="modal-title">Thêm bệnh vào thư viện</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <form action="/nghiep-vu/danh-muc-benh" method="post">
          <div class="modal-body">
            <div class="form-grid">
              <div>
                <label class="form-label">Mã bệnh</label>
                <input class="form-control" name="diseaseCode" placeholder="BENH007" required>
              </div>
              <div>
                <label class="form-label">Mã ICD-10</label>
                <input class="form-control" name="icd10Code" placeholder="J45" required>
              </div>
              <div class="span-2">
                <label class="form-label">Tên bệnh</label>
                <input class="form-control" name="diseaseName" placeholder="Hen phế quản" required>
              </div>
              <div>
                <label class="form-label">Chuyên khoa</label>
                <input class="form-control" name="specialty" placeholder="Hô hấp" required>
              </div>
              <div>
                <label class="form-label">Mức độ</label>
                <select class="form-select" name="severityLevel">
                  <option>Thấp</option>
                  <option selected>Trung bình</option>
                  <option>Cao</option>
                  <option>Nguy cấp</option>
                </select>
              </div>
              <div class="span-2">
                <label class="form-label">Triệu chứng thường gặp</label>
                <textarea class="form-control" name="commonSymptoms" rows="3" placeholder="Ho, sốt, khó thở, đau ngực..."></textarea>
              </div>
              <div class="span-2">
                <label class="form-label">Xét nghiệm/cận lâm sàng gợi ý</label>
                <textarea class="form-control" name="suggestedTests" rows="3" placeholder="Công thức máu, CRP, X-quang, siêu âm..."></textarea>
              </div>
              <div class="span-2">
                <label class="form-label">Thuốc có thể cân nhắc</label>
                <textarea class="form-control" name="recommendedMedicines" rows="3" placeholder="Tên thuốc hoặc nhóm thuốc, chỉ dùng khi phù hợp chỉ định"></textarea>
              </div>
              <div class="span-2">
                <label class="form-label">Hướng xử trí/thực hành lâm sàng</label>
                <textarea class="form-control" name="clinicalGuidance" rows="3" placeholder="Theo dõi, chăm sóc, mục tiêu điều trị, tiêu chí chuyển nặng..."></textarea>
              </div>
              <div class="span-2">
                <label class="form-label">Chống chỉ định/thận trọng</label>
                <textarea class="form-control" name="contraindications" rows="3" placeholder="Dị ứng thuốc, suy gan thận, thai kỳ, tương tác thuốc..."></textarea>
              </div>
              <div>
                <label class="form-label">Trạng thái</label>
                <select class="form-select" name="status">
                  <option selected>Đang sử dụng</option>
                  <option>Ngưng sử dụng</option>
                </select>
              </div>
              <div>
                <label class="form-label">Mô tả ngắn</label>
                <input class="form-control" name="description" placeholder="Tóm tắt nhanh cho danh mục">
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
            <button class="btn btn-primary" type="submit"><i class="bi bi-save me-2"></i>Lưu bệnh</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>
