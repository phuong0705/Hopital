<section class="module-hero">
  <div>
    <h2>Chẩn bệnh & Điều trị ngoại trú</h2>
    <p class="text-muted">Danh sách bệnh nhân đang chờ chẩn đoán và kết luận khám</p>
  </div>
  <div class="module-actions">
    <a href="/dashboard" class="btn btn-light"><i class="bi bi-grid me-2"></i>Tổng quan</a>
  </div>
</section>

<section class="panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm tên bệnh nhân hoặc mã HSBA" data-module-search="diagnosisTable">
    </div>
  </div>

  <div class="table-responsive">
    <table class="table app-table" id="diagnosisTable">
      <thead>
        <tr>
          <th>Mã HSBA</th>
          <th>Bệnh nhân</th>
          <th>Mã BN</th>
          <th>Chẩn đoán ban đầu</th>
          <th>Trạng thái</th>
          <th>Ngày tạo</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => { %>
          <tr data-search="<%= `${row.recordCode} ${row.patientName}`.toLowerCase() %>">
            <td><strong><%= row.recordCode %></strong></td>
            <td><%= row.patientName %></td>
            <td><span class="patient-code-pill"><%= row.patientCode %></span></td>
            <td class="text-wrap-cell"><%= row.diagnosis %></td>
            <td><%- include('../partials/badge', { text: row.status }) %></td>
            <td><%= format.date(row.createdAt) %></td>
            <td class="text-end">
              <a class="btn btn-sm btn-primary" href="/medical-records/<%= row.recordId %>">Chẩn bệnh</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
