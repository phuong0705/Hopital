<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Lịch sử khám bệnh</h2>
  <div class="d-flex gap-2">
    <button class="btn btn-light btn-sm" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light btn-sm" type="button" data-export-table="treatmentsTable" data-filename="lich-su-kham-benh.csv">
      <i class="bi bi-file-earmark-spreadsheet me-2"></i>Excel
    </button>
  </div>
</div>

<section class="panel">
  <form class="patient-filter-form compact mb-4" method="get">
    <div class="d-flex align-items-center gap-2">
      <label class="text-nowrap small fw-bold">Từ ngày:</label>
      <input type="date" name="startDate" class="form-control" value="<%= filters.startDate || '' %>">
    </div>
    <div class="d-flex align-items-center gap-2">
      <label class="text-nowrap small fw-bold">Đến ngày:</label>
      <input type="date" name="endDate" class="form-control" value="<%= filters.endDate || '' %>">
    </div>
    <button class="btn btn-dark" type="submit"><i class="bi bi-funnel me-2"></i>Lọc</button>
    <% if (filters.startDate || filters.endDate) { %>
      <a class="btn btn-light" href="/patients/me/treatments"><i class="bi bi-x-circle me-2"></i>Bỏ lọc</a>
    <% } %>
  </form>

  <div class="table-responsive">
    <table class="table app-table" id="treatmentsTable">
      <thead>
        <tr>
          <th class="no-export" style="width: 40px;"></th>
          <th>Thời gian</th>
          <th>Nội dung điều trị</th>
          <th>Bác sĩ / Điều dưỡng</th>
          <th>Ghi chú</th>
          <th>Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% data.treatments.forEach(item => { %>
          <tr>
            <td class="no-export">
              <span class="list-icon info sm"><i class="bi bi-activity text-primary"></i></span>
            </td>
            <td><strong><%= format.datetime(item.scheduledTime) %></strong></td>
            <td class="text-wrap-cell" style="max-width: 300px;"><strong><%= item.treatmentContent %></strong></td>
            <td><%= item.assigneeName %></td>
            <td class="text-muted"><%= item.note || '--' %></td>
            <td><%- include('../partials/badge', { text: item.status }) %></td>
          </tr>
        <% }) %>
        <% if (!data.treatments.length) { %>
          <tr><td colspan="6" class="text-center py-4 text-muted">Không tìm thấy dữ liệu trong khoảng thời gian này.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
