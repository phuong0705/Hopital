<%- include('../partials/patient-portal-header', { data }) %>

<section class="panel mt-4">
  <div class="panel-header">
    <div>
      <h2>Lịch điều trị</h2>
    </div>
  </div>
  <div class="list-stack">
    <% data.treatments.forEach(item => { %>
      <div class="list-item">
        <span class="list-icon info"><i class="bi bi-calendar2-pulse"></i></span>
        <div>
          <strong><%= item.treatmentContent %></strong>
          <small><%= format.datetime(item.scheduledTime) %> · <%= item.assigneeName %> · <%= item.note || 'Không có ghi chú' %></small>
        </div>
        <%- include('../partials/badge', { text: item.status }) %>
      </div>
    <% }) %>
    <% if (!data.treatments.length) { %>
    <% } %>
  </div>
</section>
