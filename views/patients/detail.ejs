<section class="detail-hero patient-detail-hero">
  <div>
    <h2><%= patient.full_name %></h2>
    <p><%= patient.gender %> · <%= format.age(patient.date_of_birth) %> tuổi · <%= patient.phone || 'Chưa có SĐT' %></p>
  </div>
  <%- include('../partials/badge', { text: patient.admission_status || patient.appointment_status || 'Chưa nhập viện' }) %>
</section>

<ul class="nav nav-pills gap-2 mt-4">
  <li class="nav-item"><a class="nav-link active" href="#patientClinical">Hồ sơ nội trú</a></li>
  <li class="nav-item"><a class="nav-link" href="#patientCosts">Chi phí điều trị</a></li>
</ul>

<section class="patient-detail-grid mt-4" id="patientClinical">
  <div class="panel patient-clinical-summary">
    <div class="panel-header">
      <div>
        <h2>Thông tin điều trị</h2>
      </div>
    </div>
    <div class="patient-detail-cards">
      <div class="patient-detail-card">
        <i class="bi bi-door-open"></i>
        <small>Phòng / giường</small>
        <strong><%= patient.room_code || 'Chưa xếp phòng' %> / <%= patient.bed_code || 'Chưa xếp giường' %></strong>
      </div>
      <div class="patient-detail-card">
        <i class="bi bi-virus"></i>
        <small>Bệnh / chẩn đoán</small>
        <strong><%= patient.initial_diagnosis || 'Chưa cập nhật' %></strong>
      </div>
      <div class="patient-detail-card">
        <i class="bi bi-person-vcard"></i>
        <small>Bác sĩ phụ trách</small>
        <strong><%= patient.doctor_name || 'Chưa phân công' %></strong>
      </div>
      <div class="patient-detail-card">
        <i class="bi bi-hospital"></i>
        <small>Khoa điều trị</small>
        <strong><%= patient.department_name || 'Chưa xếp khoa' %></strong>
      </div>
    </div>
  </div>

  <% if (patient.appointment_id && !patient.admission_id) { %>
    <div class="panel">
      <div class="panel-header">
        <div>
          <h2>Thông tin lịch hẹn</h2>
        </div>
      </div>
      <dl class="info-list compact">
        <dt>Mã lịch hẹn</dt>
        <dd><%= patient.appointment_code %></dd>
        <dt>Thời gian hẹn</dt>
        <dd><%= format.datetime(patient.appointment_time) %></dd>
        <dt>Lý do khám</dt>
        <dd><%= patient.appointment_reason || 'Khám theo lịch hẹn' %></dd>
        <dt>Trạng thái</dt>
        <dd><%- include('../partials/badge', { text: patient.appointment_status || 'Chưa khám' }) %></dd>
      </dl>
    </div>
  <% } %>

  <div class="panel">
    <div class="panel-header">
      <div>
        <h2>Thông tin nhập viện</h2>
      </div>
    </div>
    <dl class="info-list compact">
      <dt>Ngày nhập viện</dt>
      <dd><%= patient.admission_date ? format.datetime(patient.admission_date) : 'Chưa cập nhật' %></dd>
      <dt>Tình trạng ban đầu</dt>
      <dd><%= patient.initial_condition || 'Chưa cập nhật' %></dd>
      <dt>Mức độ ưu tiên</dt>
      <dd><%- include('../partials/badge', { text: patient.priority_level || 'Trung bình' }) %></dd>
    </dl>
  </div>

  <div class="panel">
    <div class="panel-header">
      <div>
        <h2>Thông tin hành chính</h2>
      </div>
    </div>
    <dl class="info-list compact">
      <dt>CCCD</dt>
      <dd><%= patient.identity_number || 'Chưa cập nhật' %></dd>
      <dt>BHYT</dt>
      <dd><%= patient.health_insurance_no || 'Chưa cập nhật' %></dd>
      <dt>Địa chỉ</dt>
      <dd><%= patient.address || 'Chưa cập nhật' %></dd>
      <dt>Người thân</dt>
      <dd><%= patient.emergency_contact_name || 'Chưa cập nhật' %> <%= patient.emergency_contact_phone ? `· ${patient.emergency_contact_phone}` : '' %></dd>
    </dl>
  </div>
</section>

<section class="panel mt-4" id="patientCosts">
  <div class="panel-header">
    <div>
      <h2>Chi phí điều trị</h2>
      <small>Chi phí phát sinh theo hồ sơ nội trú hiện tại.</small>
    </div>
  </div>
  <div class="module-table-wrap">
    <table class="table app-table">
      <thead>
        <tr>
          <th>Ngày phát sinh</th>
          <th>Loại chi phí</th>
          <th>Nội dung</th>
          <th>Khoa/phòng</th>
          <th>Người ghi nhận</th>
          <th>Số lượng</th>
          <th>Đơn giá</th>
          <th>Thành tiền</th>
          <th>Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% treatmentCosts.forEach(cost => { %>
          <tr>
            <td><%= format.datetime(cost.incurredAt) %></td>
            <td><%= cost.costType %></td>
            <td class="text-wrap-cell compact"><%= cost.content %></td>
            <td><%= cost.departmentName || '-' %></td>
            <td><%= cost.recordedBy || '-' %></td>
            <td><%= Number(cost.quantity || 0).toLocaleString('vi-VN') %></td>
            <td><%= format.currency(cost.unitPrice || 0) %></td>
            <td><strong><%= format.currency(cost.amount || 0) %></strong></td>
            <td><%- include('../partials/badge', { text: cost.status }) %></td>
          </tr>
        <% }) %>
        <% if (!treatmentCosts.length) { %>
          <tr><td colspan="9" class="text-center py-4 text-muted">Chưa có chi phí điều trị phát sinh.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
