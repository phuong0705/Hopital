<%
  const patient = data.patient;
  const nextTreatment = data.treatments && data.treatments.length ? data.treatments[0] : null;
  const pendingLabs = data.labTests.filter(item => item.status !== 'Đã có kết quả').length;
  const unpaid = data.billing && data.billing.paymentStatus !== 'Đã thanh toán';
%>

<section class="patient-summary-grid mt-4">
  <div class="panel">
    <div class="panel-header">
      <div>
        <h2>Thông tin điều trị</h2>
      </div>
      <%- include('../partials/badge', { text: patient.admission_status || 'Chưa nhập viện' }) %>
    </div>
    <dl class="info-list compact">
      <dt>Mã hồ sơ</dt><dd><%= patient.record_code || 'Chưa có' %></dd>
      <dt>Khoa</dt><dd><%= patient.department_name || 'Chưa phân khoa' %></dd>
      <dt>Phòng / giường</dt><dd><%= patient.room_code || 'Chưa xếp' %> / <%= patient.bed_code || 'Chưa xếp' %></dd>
      <dt>Bác sĩ</dt><dd><%= patient.doctor_name || 'Chưa phân công' %></dd>
      <dt>Chẩn đoán</dt><dd><%= patient.initial_diagnosis || 'Chưa cập nhật' %></dd>
    </dl>
  </div>

  <div class="panel">
    <div class="panel-header">
      <div>
        <h2>Thẻ BHYT của tôi</h2>
      </div>
      <i class="bi bi-shield-check text-success fs-4"></i>
    </div>
    <div class="p-3">
      <div class="p-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-4 position-relative overflow-hidden">
        <div class="d-flex justify-content-between mb-4">
          <i class="bi bi-heart-pulse-fill text-primary fs-2"></i>
          <span class="badge bg-primary text-white px-3 py-2 rounded-pill">SỐ THẺ BHYT</span>
        </div>
        <h3 class="mb-4 font-monospace tracking-widest"><%= patient.id_card_number || 'CHƯA CẬP NHẬT' %></h3>
        <div class="row g-3 small">
          <div class="col-6">
            <div class="text-muted opacity-75">Họ tên</div>
            <div class="fw-bold"><%= patient.full_name %></div>
          </div>
          <div class="col-6 text-end">
            <div class="text-muted opacity-75">Hết hạn</div>
            <div class="fw-bold text-danger">31/12/2026</div>
          </div>
        </div>
        <i class="bi bi-shield-check position-absolute bottom-0 end-0 text-primary opacity-10" style="font-size: 100px; margin: -20px;"></i>
      </div>
      <div class="mt-3 small text-muted text-center italic">
        <i class="bi bi-info-circle me-1"></i> Thông tin được đồng bộ trực tiếp từ hệ thống BHXH
      </div>
    </div>
  </div>
</section>
