<%
  const dueAmount = (data.treatmentCosts || [])
    .filter(item => ['Đã thực hiện', 'Đã tính phí'].includes(item.status))
    .reduce((sum, item) => sum + Number(item.amount || 0), 0);
  const paidAmount = (data.inpatientReceipts || [])
    .reduce((sum, item) => sum + Number(item.paidAmount || 0), 0);
%>

<section class="dashboard-grid mt-4">
  <div class="panel">
    <div class="panel-header">
      <div>
        <h2>Viện phí đến hạn</h2>
        <small>Bệnh nhân/người nhà thanh toán tại quầy thu ngân.</small>
      </div>
      <%- include('../partials/badge', { text: dueAmount > 0 ? 'Chờ thanh toán' : 'Không còn phí đến hạn' }) %>
    </div>
    <div class="p-3">
      <dl class="info-list">
        <dt>Chi phí đến hạn</dt><dd><strong class="fs-4 text-primary"><%= format.currency(dueAmount) %></strong></dd>
        <dt>Đã thanh toán</dt><dd><%= format.currency(paidAmount) %></dd>
        <dt>Hướng dẫn</dt><dd>Vui lòng liên hệ quầy thu ngân để lập phiếu thu và xác nhận thanh toán.</dd>
      </dl>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <div>
        <h2>Phiếu thu đã lập</h2>
      </div>
    </div>
    <div class="list-stack">
      <% (data.inpatientReceipts || []).forEach(receipt => { %>
        <div class="list-item">
          <span class="list-icon info"><i class="bi bi-receipt"></i></span>
          <div>
            <strong><%= receipt.receiptCode %></strong>
            <small><%= format.datetime(receipt.createdAt) %> · <%= receipt.paymentMethod %> · <%= receipt.cashierName %></small>
          </div>
          <div class="text-end">
            <strong><%= format.currency(receipt.paidAmount) %></strong>
            <%- include('../partials/badge', { text: receipt.paymentStatus }) %>
          </div>
        </div>
      <% }) %>
      <% if (!(data.inpatientReceipts || []).length) { %>
        <div class="p-4 text-center text-muted">Chưa có phiếu thu viện phí.</div>
      <% } %>
    </div>
  </div>
</section>

<section class="panel mt-4">
  <div class="panel-header">
    <div>
      <h2>Chi tiết chi phí điều trị</h2>
    </div>
  </div>
  <div class="module-table-wrap">
    <table class="table app-table">
      <thead>
        <tr>
          <th>Ngày phát sinh</th>
          <th>Loại chi phí</th>
          <th>Nội dung</th>
          <th>Khoa/phòng</th>
          <th>Người ghi nhận</th>
          <th>Số lượng</th>
          <th>Đơn giá</th>
          <th>Thành tiền</th>
          <th>Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% (data.treatmentCosts || []).forEach(item => { %>
          <tr>
            <td><%= format.datetime(item.incurredAt) %></td>
            <td><%= item.costType %></td>
            <td class="text-wrap-cell compact"><%= item.content %></td>
            <td><%= item.departmentName || '-' %></td>
            <td><%= item.recordedBy || '-' %></td>
            <td><%= Number(item.quantity || 0).toLocaleString('vi-VN') %></td>
            <td><%= format.currency(item.unitPrice || 0) %></td>
            <td><strong><%= format.currency(item.amount || 0) %></strong></td>
            <td><%- include('../partials/badge', { text: item.status }) %></td>
          </tr>
        <% }) %>
        <% if (!(data.treatmentCosts || []).length) { %>
          <tr><td colspan="9" class="text-center py-4 text-muted">Chưa có chi phí điều trị phát sinh.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
