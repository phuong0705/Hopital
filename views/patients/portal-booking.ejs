<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Đặt lịch tái khám</h2>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <section class="panel">
      <div class="panel-header">
        <div><h2>Đăng ký lịch hẹn</h2></div>
      </div>
      <% if (data.discharge) { %>
      <form action="/patients/me/booking" method="post" class="p-3">
        <div class="mb-3">
          <label class="form-label">Chọn khoa</label>
          <select name="departmentId" class="form-select" required>
            <option value="">-- Chọn khoa khám --</option>
            <% departments.forEach(dept => { %>
              <option value="<%= dept.departmentId %>"><%= dept.departmentName %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Bác sĩ mong muốn (không bắt buộc)</label>
          <select name="doctorId" class="form-select">
            <option value="">-- Để hệ thống tự phân công --</option>
            <% doctors.forEach(doc => { %>
              <option value="<%= doc.doctorId %>"><%= doc.fullName %> (<%= doc.specialty %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-md-7">
            <label class="form-label">Ngày hẹn</label>
            <input type="date" name="requestedDate" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="col-md-5">
            <label class="form-label">Giờ hẹn</label>
            <input type="time" name="requestedTime" class="form-control" required>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Lý do tái khám</label>
          <textarea name="reason" class="form-control" rows="3" placeholder="Ghi chú triệu chứng hoặc yêu cầu cụ thể..."></textarea>
        </div>
        <button class="btn btn-primary w-100 py-2"><i class="bi bi-calendar-check me-2"></i>Gửi yêu cầu đặt lịch</button>
      </form>
      <% } else { %>
        <div class="p-3">
          <div class="alert alert-warning mb-0">
            Chỉ bệnh nhân đã xuất viện mới được đặt lịch tái khám. Hồ sơ hiện tại chưa có thông tin xuất viện.
          </div>
        </div>
      <% } %>
    </section>
  </div>

  <div class="col-lg-7">
    <section class="panel">
      <div class="panel-header">
        <div><h2>Lịch sử yêu cầu</h2></div>
      </div>
      <div class="table-responsive">
        <table class="table app-table mb-0">
          <thead>
            <tr>
              <th>Ngày hẹn</th>
              <th>Khoa / Bác sĩ</th>
              <th>Lý do</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% history.forEach(item => { 
              const timeStr = item.requestedTime instanceof Date 
                ? item.requestedTime.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', hour12: false })
                : item.requestedTime;
            %>
              <tr>
                <td>
                  <strong><%= format.date(item.requestedDate) %></strong>
                  <div class="small text-muted"><%= timeStr %></div>
                </td>
                <td>
                  <div><%= item.departmentName %></div>
                  <small class="text-muted"><%= item.doctorName || 'Tự động phân công' %></small>
                </td>
                <td class="text-wrap-cell" style="max-width: 150px;"><%= item.reason || '--' %></td>
                <td><%- include('../partials/badge', { text: item.status }) %></td>
              </tr>
            <% }) %>
            <% if (!history.length) { %>
              <tr><td colspan="4" class="text-center py-5 text-muted">Bạn chưa có lịch hẹn nào.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
