<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Kết quả xét nghiệm</h2>
  <div class="d-flex gap-2">
    <button class="btn btn-light btn-sm" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light btn-sm" type="button" data-export-table="labTestsTable" data-filename="ket-qua-xet-nghiem.csv">
      <i class="bi bi-file-earmark-spreadsheet me-2"></i>Excel
    </button>
  </div>
</div>

<section class="panel">
  <form class="patient-filter-form compact mb-4" method="get">
    <div class="d-flex align-items-center gap-2">
      <label class="text-nowrap small fw-bold">Từ ngày:</label>
      <input type="date" name="startDate" class="form-control" value="<%= filters.startDate || '' %>">
    </div>
    <div class="d-flex align-items-center gap-2">
      <label class="text-nowrap small fw-bold">Đến ngày:</label>
      <input type="date" name="endDate" class="form-control" value="<%= filters.endDate || '' %>">
    </div>
    <button class="btn btn-dark" type="submit"><i class="bi bi-funnel me-2"></i>Lọc</button>
    <% if (filters.startDate || filters.endDate) { %>
      <a class="btn btn-light" href="/patients/me/labtests"><i class="bi bi-x-circle me-2"></i>Bỏ lọc</a>
    <% } %>
  </form>

  <div class="table-responsive">
    <table class="table app-table" id="labTestsTable">
      <thead>
        <tr>
          <th>Thời gian</th>
          <th>Loại xét nghiệm</th>
          <th>Kết quả</th>
          <th>Ghi chú / ảnh</th>
          <th>Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% data.labTests.forEach(item => { %>
          <tr>
            <td><strong><%= format.datetime(item.orderedDate) %></strong></td>
            <td><%= item.testType %></td>
            <td><%= item.resultSummary || 'Chưa có kết quả' %></td>
            <td class="text-wrap-cell compact">
              <% if (item.resultNote) { %>
                <div><%= item.resultNote %></div>
              <% } %>
              <% if (item.resultFiles && item.resultFiles.length) { %>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  <% item.resultFiles.forEach(file => { %>
                    <a class="btn btn-sm btn-light" href="<%= file.url %>" target="_blank" rel="noopener">
                      <i class="bi bi-image me-1"></i>Ảnh
                    </a>
                  <% }) %>
                </div>
              <% } %>
              <% if (!item.resultNote && !(item.resultFiles && item.resultFiles.length)) { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td><%- include('../partials/badge', { text: item.status }) %></td>
          </tr>
        <% }) %>
        <% if (!data.labTests.length) { %>
          <tr><td colspan="5" class="text-center py-4 text-muted">Không tìm thấy dữ liệu trong khoảng thời gian này.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
