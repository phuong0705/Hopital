<%
  const blank = !data;
  const prescription = data?.prescription || {};
  const patient = data?.patient || {};
  const record = data?.record || {};
  const care = data?.care || {};
  const medicines = data?.medicines || [];
  const dot = (value) => value || '........................................';
  const longDot = (value) => value || '................................................................';
  const roomBed = [care.roomCode, care.bedCode].filter(Boolean).join('/') || '';
  const departmentRoomBed = [care.departmentName, roomBed].filter(Boolean).join(' - ');
  const allergyText = (record.allergies || '').trim();
  const hasAllergy = allergyText && !['không', 'khong', 'chưa ghi nhận', 'chua ghi nhan'].includes(allergyText.toLowerCase());
  const medicineRows = [...medicines];
  while (medicineRows.length < 6) medicineRows.push({});
%>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #eef3f7;
      color: #000;
      font-family: "Times New Roman", Times, serif;
      font-size: 14px;
    }
    .toolbar {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      padding: 12px 16px;
      background: #fff;
      border-bottom: 1px solid #d7dee8;
      font-family: Arial, sans-serif;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .toolbar button {
      border: 1px solid #0b82b7;
      background: #0089bd;
      color: #fff;
      border-radius: 6px;
      padding: 8px 14px;
      font-weight: 700;
      cursor: pointer;
    }
    .page {
      width: 297mm;
      min-height: 210mm;
      margin: 16px auto;
      background: #fff;
      padding: 8mm 10mm;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.14);
    }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 1px solid #777; padding: 4px 8px; vertical-align: top; }
    .top td { text-align: center; padding: 2px 8px; }
    .top .left { text-align: left; }
    .top .right { text-align: right; }
    h1 {
      margin: 8px 0 8px;
      text-align: center;
      font-size: 26px;
      letter-spacing: 0;
    }
    h2 {
      margin: 8px 0 4px;
      font-size: 17px;
    }
    .label { width: 25%; font-weight: 700; background: #f2f2f2; }
    .value { width: 25%; }
    .medicine th {
      text-align: center;
      background: #f7f7f7;
      font-weight: 700;
    }
    .medicine td { height: 26px; }
    .confirm-title { margin: 6px 0 4px; font-size: 17px; font-weight: 700; }
    .signature th { text-align: center; background: #f7f7f7; }
    .signature td {
      height: 80px;
      text-align: center;
      vertical-align: bottom;
      padding-bottom: 28px;
    }
    .small-note { font-style: italic; }
    .no-border { border: 0; }
    @media print {
      @page { size: A4 landscape; margin: 8mm; }
      body { background: #fff; }
      .toolbar { display: none; }
      .page {
        width: auto;
        min-height: auto;
        margin: 0;
        padding: 0;
        box-shadow: none;
      }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button type="button" onclick="window.print()">In biểu mẫu</button>
  </div>

  <main class="page">
    <table class="top">
      <tr>
        <td class="left">CƠ SỞ KCB: ........................</td>
        <td><strong>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong></td>
        <td class="right">Mã mẫu BM-NT-15</td>
      </tr>
      <tr>
        <td class="left">Khoa/Phòng: <%= care.departmentName || '........................' %></td>
        <td>Độc lập - Tự do - Hạnh phúc</td>
        <td class="right">Số phiếu: <%= prescription.prescriptionCode || '................' %></td>
      </tr>
    </table>

    <h1>ĐƠN THUỐC NỘI TRÚ</h1>

    <h2>1. Thông tin</h2>
    <table>
      <tr>
        <td class="label">Họ tên</td>
        <td class="value"><%= dot(patient.patientName) %></td>
        <td class="label">Mã NB/Số BA</td>
        <td class="value"><%= patient.patientCode || record.recordCode || '........................................' %></td>
      </tr>
      <tr>
        <td class="label">Khoa/Buồng/Giường</td>
        <td class="value"><%= longDot(departmentRoomBed) %></td>
        <td class="label">Chẩn đoán</td>
        <td class="value"><%= longDot(record.diagnosis) %></td>
      </tr>
      <tr>
        <td class="label">Dị ứng thuốc</td>
        <td class="value">☐ Không&nbsp;&nbsp; <%= hasAllergy ? '☑' : '☐' %> Có: <%= hasAllergy ? allergyText : '................' %></td>
        <td class="label"></td>
        <td class="value"><%= blank ? '........................................' : '' %></td>
      </tr>
    </table>

    <h2>2. Danh mục thuốc</h2>
    <table class="medicine">
      <thead>
        <tr>
          <th>Tên thuốc</th>
          <th>Hàm lượng</th>
          <th>Liều dùng</th>
          <th>Đường dùng</th>
          <th>Số lần/ngày</th>
          <th>Ghi chú</th>
        </tr>
      </thead>
      <tbody>
        <% medicineRows.forEach(item => { %>
          <tr>
            <td><%= item.medicineName || '' %></td>
            <td><%= item.dosage || '' %></td>
            <td><%= item.quantity ? `${item.quantity} ${item.unit || ''}` : '' %></td>
            <td><%= item.route || '' %></td>
            <td><%= item.frequency || '' %></td>
            <td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <h2>3. Xác nhận</h2>
    <table>
      <tr>
        <td class="label">Bác sĩ kê đơn</td>
        <td><%= dot(care.doctorName) %></td>
        <td class="label">Dược sĩ kiểm tra</td>
        <td>........................................</td>
      </tr>
    </table>

    <div class="confirm-title">Xác nhận</div>
    <table class="signature">
      <tr>
        <th>Người bệnh/Đại diện</th>
        <th>Nhân viên phụ trách</th>
        <th>Bác sĩ/Trưởng khoa</th>
      </tr>
      <tr>
        <td><span class="small-note">(Ký, ghi rõ họ tên)</span></td>
        <td><span class="small-note">(Ký, ghi rõ họ tên)</span></td>
        <td><span class="small-note">(Ký, ghi rõ họ tên)</span></td>
      </tr>
    </table>
  </main>
</body>
</html>
