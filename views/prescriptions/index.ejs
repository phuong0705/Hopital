<%
  const canPrescribe = locals.showPrescribeAction !== false && currentUser && ['ADMIN', 'DOCTOR'].includes(currentUser.roleCode);
  const prescriptionGroups = [];
  const prescriptionMap = new Map();

  rows.forEach((row, index) => {
    const key = row.prescriptionId || row.prescriptionCode || `${row.patientName}-${row.startDate}-${row.endDate}-${row.doctorName}-${index}`;
    if (!prescriptionMap.has(key)) {
      const group = {
        key,
        modalId: `prescriptionDetail${prescriptionGroups.length}`,
        prescriptionId: row.prescriptionId,
        prescriptionCode: row.prescriptionCode || `Đơn thuốc ${prescriptionGroups.length + 1}`,
        patientName: row.patientName,
        patientCode: row.patientCode,
        gender: row.gender,
        dateOfBirth: row.dateOfBirth,
        recordCode: row.recordCode,
        departmentName: row.departmentName,
        doctorName: row.doctorName,
        startDate: row.startDate,
        endDate: row.endDate,
        routes: new Set(),
        items: []
      };
      prescriptionMap.set(key, group);
      prescriptionGroups.push(group);
    }

    const group = prescriptionMap.get(key);
    if (row.route) group.routes.add(row.route);
    group.items.push(row);
  });

  const routeOptions = [...new Set(rows.map(row => row.route).filter(Boolean))];
%>

<section class="module-hero">
  <div>
    <h2><%= title %></h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-light" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light" type="button" data-export-table="prescriptionsTable" data-filename="don-thuoc.csv"><i class="bi bi-filetype-csv me-2"></i>CSV</button>
    <% if (canPrescribe) { %>
      <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#prescriptionModal">Kê đơn</button>
    <% } %>
  </div>
</section>

<section class="panel module-panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm bệnh nhân, thuốc, bác sĩ kê" data-module-search="prescriptionsTable">
    </div>
    <select class="form-select" data-module-filter="prescriptionsTable" data-filter-key="route">
      <option value="">Tất cả đường dùng</option>
      <% routeOptions.forEach(route => { %>
        <option><%= route %></option>
      <% }) %>
    </select>
  </div>

  <div class="d-flex flex-column gap-3">
    <% prescriptionGroups.forEach(group => {
      const routes = [...group.routes];
      const routeText = routes.join(', ') || '-';
      const medicinesPreview = group.items.slice(0, 3).map(item => item.medicineName).join(', ');
      const hiddenCount = Math.max(group.items.length - 3, 0);
      const searchText = [
        group.prescriptionCode,
        group.patientName,
        group.patientCode,
        group.recordCode,
        group.departmentName,
        group.doctorName,
        ...group.items.flatMap(item => [item.medicineName, item.dosage, item.frequency, item.route])
      ].filter(Boolean).join(' ').toLowerCase();
    %>
      <article
        class="border rounded-3 bg-white p-3 prescription-history-card"
        data-table-row="prescriptionsTable"
        data-search="<%= searchText %>"
        data-route="<%= routes.join('|') %>">
        <div class="d-flex flex-column flex-xl-row align-items-xl-center gap-3 justify-content-between">
          <div class="d-flex align-items-start gap-3 flex-grow-1">
            <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
              <i class="bi bi-person-vcard fs-4"></i>
            </div>
            <div class="flex-grow-1">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h5 class="mb-0"><%= group.patientName %></h5>
                <% if (group.patientCode) { %>
                  <span class="module-soft-pill"><%= group.patientCode %></span>
                <% } %>
                <span class="badge bg-light text-dark border"><%= group.prescriptionCode %></span>
              </div>
              <div class="row g-2 text-muted small">
                <div class="col-md-3">
                  <span class="fw-semibold text-dark">Hồ sơ:</span>
                  <%= group.recordCode || '-' %>
                </div>
                <div class="col-md-3">
                  <span class="fw-semibold text-dark">Khoa:</span>
                  <%= group.departmentName || '-' %>
                </div>
                <div class="col-md-3">
                  <span class="fw-semibold text-dark">Thời gian:</span>
                  <%= format.date(group.startDate) %> - <%= format.date(group.endDate) %>
                </div>
                <div class="col-md-3">
                  <span class="fw-semibold text-dark">Bác sĩ:</span>
                  <%= group.doctorName || '-' %>
                </div>
              </div>
              <div class="mt-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="module-soft-pill"><i class="bi bi-capsule-pill me-1"></i><%= group.items.length %> thuốc</span>
                <span class="module-soft-pill"><%= routeText %></span>
                <span class="text-muted small">
                  <%= medicinesPreview || '-' %><%= hiddenCount ? ` +${hiddenCount} thuốc` : '' %>
                </span>
              </div>
            </div>
          </div>
          <div class="d-flex flex-column flex-sm-row gap-2 flex-shrink-0">
            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#<%= group.modalId %>">
              <i class="bi bi-eye me-2"></i>Xem chi tiết đơn thuốc
            </button>
          </div>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="module-table-wrap visually-hidden">
    <table class="table app-table module-table prescriptions-table" id="prescriptionsTable">
      <thead>
        <tr>
          <th>Đơn thuốc</th>
          <th>Bệnh nhân</th>
          <th>Thuốc</th>
          <th>Liều / lần dùng</th>
          <th>Đường dùng</th>
          <th>Thời gian</th>
          <th>Bác sĩ kê</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => { %>
          <tr data-search="<%= `${row.prescriptionCode} ${row.patientName} ${row.medicineName} ${row.doctorName}`.toLowerCase() %>" data-route="<%= row.route %>">
            <td><%= row.prescriptionCode %></td>
            <td><%= row.patientName %></td>
            <td>
              <div class="module-primary">
                <strong><%= row.medicineName %></strong>
                <small><%= row.dosage %></small>
              </div>
            </td>
            <td><%= row.frequency %></td>
            <td><span class="module-soft-pill"><%= row.route %></span></td>
            <td><%= format.date(row.startDate) %> - <%= format.date(row.endDate) %></td>
            <td><%= row.doctorName %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="empty-inline module-empty <%= rows.length ? 'd-none' : '' %>" data-empty-for="prescriptionsTable">
    <i class="bi bi-search"></i>
    <strong>Không tìm thấy đơn thuốc phù hợp</strong>
  </div>
</section>

<% prescriptionGroups.forEach(group => { %>
  <div class="modal fade" id="<%= group.modalId %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content app-modal">
        <div class="modal-header">
          <div>
            <h5 class="modal-title">Chi tiết đơn thuốc - <%= group.patientName %></h5>
            <small class="text-muted"><%= group.prescriptionCode %> · <%= format.date(group.startDate) %> - <%= format.date(group.endDate) %></small>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3 mb-4">
            <div class="col-md-3">
              <div class="border rounded-3 p-3 h-100">
                <small class="text-muted d-block">Bệnh nhân</small>
                <strong><%= group.patientName %></strong>
                <div class="small text-muted"><%= group.patientCode || '-' %></div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="border rounded-3 p-3 h-100">
                <small class="text-muted d-block">Hồ sơ</small>
                <strong><%= group.recordCode || '-' %></strong>
                <div class="small text-muted"><%= group.departmentName || '-' %></div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="border rounded-3 p-3 h-100">
                <small class="text-muted d-block">Bác sĩ kê</small>
                <strong><%= group.doctorName || '-' %></strong>
              </div>
            </div>
            <div class="col-md-3">
              <div class="border rounded-3 p-3 h-100">
                <small class="text-muted d-block">Số thuốc</small>
                <strong><%= group.items.length %></strong>
                <div class="small text-muted"><%= [...group.routes].join(', ') || '-' %></div>
              </div>
            </div>
          </div>

          <div class="module-table-wrap">
            <table class="table app-table module-table">
              <thead>
                <tr>
                  <th>Thuốc</th>
                  <th>Liều</th>
                  <th>Lần dùng</th>
                  <th>Đường dùng</th>
                  <th>Số lượng</th>
                </tr>
              </thead>
              <tbody>
                <% group.items.forEach(item => { %>
                  <tr>
                    <td>
                      <div class="module-primary">
                        <strong><%= item.medicineName %></strong>
                      </div>
                    </td>
                    <td><%= item.dosage || '-' %></td>
                    <td><%= item.frequency || '-' %></td>
                    <td><span class="module-soft-pill"><%= item.route || '-' %></span></td>
                    <td><%= item.quantity ? `${item.quantity} ${item.unit || ''}` : '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-light" type="button" data-bs-dismiss="modal">Đóng</button>
          <button class="btn btn-primary" type="button" data-print-page><i class="bi bi-printer me-2"></i>In đơn thuốc</button>
        </div>
      </div>
    </div>
  </div>
<% }) %>

<% if (canPrescribe) { %>
<div class="modal fade" id="prescriptionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content app-modal">
      <form action="/prescriptions" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Kê đơn thuốc</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Bệnh nhân / hồ sơ</label>
              <select name="recordId" class="form-select" required>
                <% activeRecords.forEach(item => { %>
                  <option value="<%= item.recordId %>"><%= item.patientName %> - <%= item.departmentName %></option>
                <% }) %>
              </select>
            </div>
            <% if (selectedDoctor) { %>
              <input type="hidden" name="doctorId" value="<%= selectedDoctor.doctorId %>">
              <div class="col-md-6">
                <label class="form-label">Bác sĩ kê</label>
                <input class="form-control" value="<%= selectedDoctor.fullName %> - <%= selectedDoctor.specialty %>" disabled>
              </div>
            <% } else { %>
              <div class="col-md-6">
                <label class="form-label">Bác sĩ kê</label>
                <select name="doctorId" class="form-select" required>
                  <% doctors.forEach(doctor => { %>
                    <option value="<%= doctor.doctorId %>"><%= doctor.fullName %> - <%= doctor.specialty %></option>
                  <% }) %>
                </select>
              </div>
            <% } %>
            <div class="col-md-6">
              <label class="form-label">Tên thuốc</label>
              <input name="medicineName" class="form-control" placeholder="Ceftriaxone" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Liều dùng</label>
              <input name="dosage" class="form-control" placeholder="2g" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Số lần dùng</label>
              <input name="frequency" class="form-control" placeholder="1 lần/ngày" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Đường dùng</label>
              <select name="route" class="form-select" required>
                <option>Uống</option>
                <option>Tĩnh mạch</option>
                <option>Tiêm dưới da</option>
                <option>Tiêm bắp</option>
                <option>Khí dung</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Số lượng</label>
              <input name="quantity" type="number" min="1" value="1" class="form-control" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Đơn vị</label>
              <input name="unit" class="form-control" value="viên" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Bắt đầu</label>
              <input name="startDate" type="date" class="form-control" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Kết thúc</label>
              <input name="endDate" type="date" class="form-control" required>
            </div>
            <div class="col-md-8">
              <label class="form-label">Ghi chú</label>
              <input name="note" class="form-control" placeholder="Dặn dò khi dùng thuốc">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-light" type="button" data-bs-dismiss="modal">Đóng</button>
          <button class="btn btn-primary" type="submit"><i class="bi bi-save me-2"></i>Lưu đơn thuốc</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>
