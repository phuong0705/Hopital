<section class="module-hero">
  <div>
    <h2>Quản lý Roles & Quyền</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoleModal">
      <i class="bi bi-shield-plus me-2"></i>Thêm vai trò
    </button>
    <a class="btn btn-light" href="/users"><i class="bi bi-people me-2"></i>Người dùng</a>
  </div>
</section>

<section class="panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm module, route hoặc nhóm quyền" data-module-search="rolePermissionsTable">
    </div>
    <select class="form-select" data-module-filter="rolePermissionsTable" data-filter-key="group">
      <option value="">Tất cả nhóm</option>
      <% [...new Set(modules.map(item => item.groupTitle))].forEach(group => { %>
        <option><%= group %></option>
      <% }) %>
    </select>
  </div>

  <form action="/admin/roles-permissions/modules" method="post">
  <div class="module-table-wrap">
    <table class="table app-table module-table" id="rolePermissionsTable">
      <thead>
        <tr>
          <th>Module</th>
          <% roles.forEach(role => { %>
            <th class="text-center"><%= role.roleCode %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% modules.forEach(item => { %>
          <tr data-search="<%= `${item.title} ${item.key} ${item.href} ${item.groupTitle} ${item.roles.join(' ')}`.toLowerCase() %>" data-group="<%= item.groupTitle %>">
            <td>
              <div class="module-primary">
                <strong><%= item.title %></strong>
                <small><%= item.groupCode %>. <%= item.groupTitle %> · <%= item.href %></small>
              </div>
            </td>
            <% roles.forEach(role => {
              const allowed = permissionMatrix[item.key] && permissionMatrix[item.key][role.roleCode];
              const pairValue = `${item.key}::${role.roleCode}`;
            %>
              <td class="text-center">
                <% if (role.roleCode === 'ADMIN') { %>
                  <span class="status-badge status-success">Luôn cho phép</span>
                <% } else { %>
                  <label class="permission-switch" title="<%= allowed ? 'Đang cho phép' : 'Đang chặn' %>">
                    <input
                      type="checkbox"
                      name="permissions"
                      value="<%= pairValue %>"
                      <%= allowed ? 'checked' : '' %>
                      data-permission-toggle>
                    <span></span>
                  </label>
                <% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="d-flex flex-wrap justify-content-end align-items-center gap-3 mt-3">
    <button class="btn btn-primary" type="submit"><i class="bi bi-save me-2"></i>Lưu ma trận quyền</button>
  </div>
  </form>
  <div class="empty-inline d-none" data-empty-for="rolePermissionsTable">
    <i class="bi bi-search"></i>
    <strong>Không tìm thấy module phù hợp</strong>
  </div>
</section>

<!-- Modal Tạo mới -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content app-modal">
      <form action="/admin/roles" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Thêm vai trò mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Mã role (Code)</label>
              <input type="text" name="roleCode" class="form-control" required placeholder="Ví dụ: MANAGER, TECH...">
            </div>
            <div class="col-12">
              <label class="form-label">Tên hiển thị</label>
              <input type="text" name="roleName" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label">Mô tả</label>
              <textarea name="description" class="form-control" rows="3"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-primary">Lưu vai trò</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Chỉnh sửa -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content app-modal">
      <form id="editRoleForm" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Chỉnh sửa vai trò</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Mã role (Code)</label>
              <input type="text" name="roleCode" id="edit_roleCode" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label">Tên hiển thị</label>
              <input type="text" name="roleName" id="edit_roleName" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label">Mô tả</label>
              <textarea name="description" id="edit_description" class="form-control" rows="3"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const editModal = document.getElementById('editRoleModal');
    if (editModal) {
      editModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const role = JSON.parse(button.getAttribute('data-role'));
        
        const form = document.getElementById('editRoleForm');
        form.action = `/admin/roles/${role.roleId}/update`;
        
        document.getElementById('edit_roleCode').value = role.roleCode;
        document.getElementById('edit_roleName').value = role.roleName;
        document.getElementById('edit_description').value = role.description || '';
      });
    }
  });
</script>
