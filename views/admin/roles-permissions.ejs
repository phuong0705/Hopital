<section class="module-hero">
  <div>
    <h2>Quản lý Roles & Quyền</h2>
    <p class="text-muted mb-0">Vai trò lấy từ bảng Roles; quyền truy cập lấy từ cấu hình module đang chạy.</p>
  </div>
  <div class="module-actions">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoleModal">
      <i class="bi bi-shield-plus me-2"></i>Thêm vai trò
    </button>
    <a class="btn btn-light" href="/users"><i class="bi bi-people me-2"></i>Người dùng</a>
  </div>
</section>

<section class="patient-action-grid compact mt-4">
  <div class="patient-action-card">
    <i class="bi bi-shield-check"></i>
    <strong><%= roles.length %> vai trò</strong>
    <span>Định nghĩa trong bảng Roles.</span>
  </div>
  <div class="patient-action-card">
    <i class="bi bi-people"></i>
    <strong><%= counts.users || 0 %> tài khoản</strong>
    <span>Tài khoản đang có trong hệ thống.</span>
  </div>
  <div class="patient-action-card">
    <i class="bi bi-grid"></i>
    <strong><%= modules.length %> module</strong>
    <span>Module được kiểm soát theo role.</span>
  </div>
</section>

<section class="panel mt-4">
  <div class="panel-header">
    <div>
      <h2>Danh sách vai trò (Roles)</h2>
      <p>Đây là nguồn phân quyền gốc cho người dùng đăng nhập.</p>
    </div>
  </div>
  <div class="module-table-wrap">
    <table class="table app-table module-table">
      <thead>
        <tr>
          <th>Mã role</th>
          <th>Tên role</th>
          <th>Mô tả</th>
          <th>Người dùng</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% roles.forEach(role => { %>
          <tr>
            <td><strong><%= role.roleCode %></strong></td>
            <td><%= role.roleName %></td>
            <td class="text-wrap-cell"><%= role.description || '-' %></td>
            <td><%= role.userCount %></td>
            <td class="text-end">
              <div class="table-actions">
                <button class="btn btn-sm btn-light action-icon" 
                  data-bs-toggle="modal" 
                  data-bs-target="#editRoleModal"
                  data-role='<%= JSON.stringify(role) %>'>
                  <i class="bi bi-pencil"></i>
                </button>
                <form action="/admin/roles/<%= role.roleId %>/delete" method="post" class="d-inline" onsubmit="return confirm('Xóa vai trò này?')">
                  <button class="btn btn-sm btn-light text-danger action-icon" <%= role.userCount > 0 ? 'disabled' : '' %>>
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel mt-4">
  <div class="panel-header">
    <div>
      <h2>Ma trận quyền module</h2>
      <p>Admin luôn có toàn quyền; các role còn lại theo cấu hình truy cập hiện tại (Registry).</p>
    </div>
    <a class="btn btn-sm btn-light" href="/admin/modules"><i class="bi bi-grid me-2"></i>Chi tiết module</a>
  </div>
  <div class="module-table-wrap">
    <table class="table app-table module-table">
      <thead>
        <tr>
          <th>Module</th>
          <% roles.forEach(role => { %>
            <th><%= role.roleCode %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% modules.forEach(item => { %>
          <tr>
            <td>
              <div class="module-primary">
                <strong><%= item.title %></strong>
                <small><%= item.groupCode %>. <%= item.groupTitle %> · <%= item.href %></small>
              </div>
            </td>
            <% roles.forEach(role => {
              const allowed = role.roleCode === 'ADMIN' || item.roles.includes(role.roleCode);
            %>
              <td>
                <% if (allowed) { %>
                  <span class="status-badge status-success">Cho phép</span>
                <% } else { %>
                  <span class="status-badge status-secondary">Chặn</span>
                <% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<!-- Modal Tạo mới -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content app-modal">
      <form action="/admin/roles" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Thêm vai trò mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Mã role (Code)</label>
              <input type="text" name="roleCode" class="form-control" required placeholder="Ví dụ: MANAGER, TECH...">
            </div>
            <div class="col-12">
              <label class="form-label">Tên hiển thị</label>
              <input type="text" name="roleName" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label">Mô tả</label>
              <textarea name="description" class="form-control" rows="3"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-primary">Lưu vai trò</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Chỉnh sửa -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content app-modal">
      <form id="editRoleForm" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Chỉnh sửa vai trò</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Mã role (Code)</label>
              <input type="text" name="roleCode" id="edit_roleCode" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label">Tên hiển thị</label>
              <input type="text" name="roleName" id="edit_roleName" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label">Mô tả</label>
              <textarea name="description" id="edit_description" class="form-control" rows="3"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const editModal = document.getElementById('editRoleModal');
    if (editModal) {
      editModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const role = JSON.parse(button.getAttribute('data-role'));
        
        const form = document.getElementById('editRoleForm');
        form.action = `/admin/roles/${role.roleId}/update`;
        
        document.getElementById('edit_roleCode').value = role.roleCode;
        document.getElementById('edit_roleName').value = role.roleName;
        document.getElementById('edit_description').value = role.description || '';
      });
    }
  });
</script>
