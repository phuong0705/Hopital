<section class="module-hero">
  <div>
    <h2>Tích hợp HIS / LIS / PACS</h2>
  </div>
  <div class="module-actions">
    <a class="btn btn-light" href="/labtests"><i class="bi bi-clipboard2-pulse me-2"></i>LIS</a>
    <a class="btn btn-primary" href="/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
  </div>
</section>

<section class="panel mt-4">
  <div class="panel-header">
    <div>
      <h2>Cấu hình kết nối đang dùng</h2>
      <p>Chỉ hiển thị trạng thái cấu hình; không lộ chuỗi kết nối nhạy cảm.</p>
    </div>
  </div>
  <div class="module-table-wrap">
    <table class="table app-table module-table">
      <thead>
        <tr>
          <th>Thành phần</th>
          <th>Nguồn cấu hình</th>
          <th>Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>SQL Server HIS</strong></td>
          <td><code>DB_SERVER</code> / <code>DATABASE_URL</code></td>
          <td><span class="status-badge <%= env.databaseConfigured ? 'status-success' : 'status-warning' %>"><%= env.databaseConfigured ? 'Đã cấu hình' : 'Thiếu cấu hình' %></span></td>
        </tr>
        <tr>
          <td><strong>Reports frontend</strong></td>
          <td><code>REPORTS_FRONTEND_URL</code></td>
          <td><span class="status-badge <%= env.reportsFrontendUrl ? 'status-success' : 'status-warning' %>"><%= env.reportsFrontendUrl || 'Chưa cấu hình' %></span></td>
        </tr>
        <tr>
          <td><strong>Reports API proxy</strong></td>
          <td><code>REPORTS_API_BASE_URL</code></td>
          <td><span class="status-badge <%= env.reportsApiBaseUrl ? 'status-success' : 'status-warning' %>"><%= env.reportsApiBaseUrl || 'Dùng mặc định backend hiện tại' %></span></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="panel mt-4">
  <div class="panel-header">
    <div>
      <h2>Tín hiệu nghiệp vụ</h2>
      <p>LIS lấy từ LabTests, PACS lấy từ nhóm chỉ định hình ảnh, HIS lấy từ Admissions.</p>
    </div>
  </div>
  <div class="module-table-wrap">
    <table class="table app-table module-table">
      <thead>
        <tr>
          <th>Hệ thống</th>
          <th>Số bản ghi</th>
          <th>Lần cập nhật cuối</th>
          <th>Đánh giá</th>
        </tr>
      </thead>
      <tbody>
        <% signals.forEach(signal => { %>
          <tr>
            <td><strong><%= signal.systemCode %></strong></td>
            <td><%= signal.totalEvents %></td>
            <td><%= signal.lastEventAt ? format.datetime(signal.lastEventAt) : '-' %></td>
            <td><span class="status-badge <%= signal.totalEvents ? 'status-success' : 'status-warning' %>"><%= signal.totalEvents ? 'Có dữ liệu' : 'Chưa phát sinh' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
