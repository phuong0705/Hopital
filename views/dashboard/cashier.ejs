<section class="dashboard-welcome">
  <div class="dashboard-welcome-content">
    <div class="login-brand dashboard-brand">
      <span class="brand-mark"><i class="bi bi-heart-pulse-fill"></i></span>
      <span>
        <strong>Bệnh viện Đa khoa Việt Nam</strong>
        <small>Hệ thống quản lý điều trị nội trú</small>
      </span>
    </div>
    <h1>Trung tâm quản lý người bệnh nội trú, hồ sơ điều trị và phối hợp chăm sóc lâm sàng.</h1>
  </div>
</section>

<section class="patient-action-grid compact mt-4">
  <a class="patient-action-card text-decoration-none" href="/patients/reception?activeMenu=cashier-reception">
    <i class="bi bi-person-plus"></i>
    <strong>Tiếp nhận bệnh nhân</strong>
    <span>Tạo hồ sơ nội trú, chọn khoa, bác sĩ và giường.</span>
  </a>
  <a class="patient-action-card text-decoration-none" href="/billing?activeMenu=cashier-billing">
    <i class="bi bi-credit-card"></i>
    <strong><%= (locals.cashierCounts && locals.cashierCounts.unpaidBills) || 0 %> phiếu chưa thu</strong>
    <span>Lập phiếu thu hoặc đối soát trạng thái thanh toán.</span>
  </a>
</section>

<section class="panel mt-4">
  <div class="module-toolbar">
    <div class="module-primary">
      <strong>Lối tắt nghiệp vụ</strong>
      <small>Các chức năng thu ngân dùng dữ liệu thật trong HIS.</small>
    </div>
  </div>
  <div class="row g-3">
    <div class="col-md-4">
      <a class="list-item text-decoration-none" href="/thu-ngan/dat-lich-hen-kham">
        <i class="bi bi-calendar-plus"></i>
        <div>
          <strong>Đặt lịch hẹn khám</strong>
          <small>Tạo và cập nhật lịch hẹn.</small>
        </div>
      </a>
    </div>
    <div class="col-md-4">
      <a class="list-item text-decoration-none" href="/nghiep-vu/hoa-don?activeMenu=cashier-invoices">
        <i class="bi bi-file-earmark"></i>
        <div>
          <strong>Quản lý hóa đơn</strong>
          <small>Tra cứu và in lại chứng từ từ phiếu thu.</small>
        </div>
      </a>
    </div>
    <div class="col-md-4">
      <a class="list-item text-decoration-none" href="/reports?tab=revenue">
        <i class="bi bi-bar-chart"></i>
        <div>
          <strong>Báo cáo thu ngân</strong>
          <small>Xem doanh thu, lượt khám và xuất viện theo quyền thu ngân.</small>
        </div>
      </a>
    </div>
  </div>
</section>
