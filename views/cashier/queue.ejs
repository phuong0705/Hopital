<section class="module-hero">
  <div>
    <h2>Quản lý hàng chờ</h2>
    <p class="text-muted mb-0">Theo dõi hàng chờ tiếp nhận, lịch hẹn trong ngày và các phiếu viện phí chưa thanh toán.</p>
  </div>
  <div class="module-actions">
    <a class="btn btn-light" href="/patients/reception?activeMenu=cashier-reception"><i class="bi bi-person-plus me-2"></i>Tiếp nhận</a>
    <a class="btn btn-primary" href="/billing?activeMenu=cashier-billing"><i class="bi bi-credit-card me-2"></i>Thanh toán</a>
  </div>
</section>

<section class="patient-action-grid compact mt-4">
  <div class="patient-action-card">
    <i class="bi bi-list-ul"></i>
    <strong><%= rows.length %> việc đang chờ</strong>
    <span>Tổng hợp từ lịch hẹn, lượt tiếp nhận và viện phí.</span>
  </div>
  <div class="patient-action-card">
    <i class="bi bi-calendar-check"></i>
    <strong><%= rows.filter(row => row.queueType === 'Lịch hẹn').length %> lịch hẹn hôm nay</strong>
    <span>Bệnh nhân cần được xác nhận tại quầy.</span>
  </div>
  <div class="patient-action-card">
    <i class="bi bi-credit-card"></i>
    <strong><%= rows.filter(row => row.queueType === 'Thanh toán viện phí').length %> phiếu chưa thu</strong>
    <span>Ưu tiên xử lý trước khi xuất viện.</span>
  </div>
</section>

<section class="panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm bệnh nhân, mã phiếu hoặc loại hàng chờ" data-module-search="queueTable">
    </div>
    <select class="form-select" data-module-filter="queueTable" data-filter-key="type">
      <option value="">Tất cả loại</option>
      <% [...new Set(rows.map(row => row.queueType))].forEach(type => { %>
        <option><%= type %></option>
      <% }) %>
    </select>
  </div>

  <div class="module-table-wrap">
    <table class="table app-table module-table" id="queueTable">
      <thead>
        <tr>
          <th>Loại</th>
          <th>Bệnh nhân</th>
          <th>Khoa</th>
          <th>Thời điểm</th>
          <th>Giá trị</th>
          <th>Trạng thái</th>
          <th class="text-end">Xử lý</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => { %>
          <tr data-search="<%= `${row.queueType} ${row.code} ${row.patientName} ${row.departmentName || ''}`.toLowerCase() %>" data-type="<%= row.queueType %>">
            <td>
              <div class="module-primary">
                <strong><%= row.queueType %></strong>
                <small><%= row.code %></small>
              </div>
            </td>
            <td><%= row.patientName %></td>
            <td><%= row.departmentName || 'Chưa phân khoa' %></td>
            <td><%= format.datetime(row.queueTime) %></td>
            <td><%= row.amount ? format.currency(row.amount) : '-' %></td>
            <td><%- include('../partials/badge', { text: row.status }) %></td>
            <td class="text-end"><a class="btn btn-sm btn-light" href="<%= row.actionHref %>">Mở</a></td>
          </tr>
        <% }) %>
        <% if (!rows.length) { %>
          <tr><td colspan="7" class="text-center py-4 text-muted">Không có hàng chờ cần xử lý.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="empty-inline module-empty d-none" data-empty-for="queueTable">
    <i class="bi bi-search"></i>
    <strong>Không tìm thấy hàng chờ phù hợp</strong>
  </div>
</section>
