<%
  const role = currentUser ? currentUser.roleCode : '';
  const isPatient = role === 'PATIENT';
  const isDoctor = role === 'DOCTOR';
  const isAdmin = role === 'ADMIN';
  const isNurse = role === 'NURSE';
  const isReceptionist = role === 'RECEPTIONIST';
  const isLab = role === 'LAB';
  const canGroup = (group) => isAdmin || group.roles.includes(role);
  const canItem = (item, group) => isAdmin || (item.roles || group.roles).includes(role);
  const adminMenuSections = [
    {
      label: 'NGƯỜI DÙNG & PHÂN QUYỀN',
      items: [
        { key: 'hr-users', label: 'Quản lý người dùng', icon: 'bi-people', href: '/users' },
        { key: 'admin-roles', label: 'Quản lý Roles & Quyền', icon: 'bi-shield-check', href: '/admin/roles-permissions' },
        { key: 'departments', label: 'Quản lý khoa / phòng', icon: 'bi-square', href: '/departments' },
        { key: 'admin-staff', label: 'Quản lý bác sĩ / nhân viên', icon: 'bi-person', href: '/admin/staff' }
      ]
    },
    {
      label: 'DANH MỤC HỆ THỐNG',
      items: [
        { key: 'catalog-diseases', label: 'Danh mục bệnh (ICD)', icon: 'bi-circle', href: '/nghiep-vu/danh-muc-benh?activeMenu=catalog-diseases' },
        { key: 'catalog-medicines', label: 'Danh mục thuốc', icon: 'bi-plus-circle', href: '/nghiep-vu/danh-muc-thuoc?activeMenu=catalog-medicines' },
        { key: 'catalog-services', label: 'Danh mục dịch vụ & Giá', icon: 'bi-headphones', href: '/nghiep-vu/danh-muc-dich-vu?activeMenu=catalog-services' }
      ]
    },
    {
      label: 'CẤU HÌNH & HỆ THỐNG',
      items: [
        { key: 'settings', label: 'Cấu hình hệ thống', icon: 'bi-gear', href: '/settings' },
        { key: 'admin-modules', label: 'Quản lý Module', icon: 'bi-grid', href: '/admin/modules' },
        { key: 'admin-integrations', label: 'Tích hợp HIS / LIS / PACS', icon: 'bi-braces', href: '/admin/integrations' },
        { key: 'admin-backup', label: 'Sao lưu & Phục hồi dữ liệu', icon: 'bi-upload', href: '/admin/backup-restore' }
      ]
    },
    {
      label: 'BÁO CÁO & GIÁM SÁT',
      items: [
        { key: 'admin-audit', label: 'Nhật ký hệ thống (Audit log)', icon: 'bi-file-earmark', href: '/admin/audit-log' },
        { key: 'admin-monitoring', label: 'Giám sát hệ thống realtime', icon: 'bi-activity', href: '/admin/monitoring' }
      ]
    }
  ];
  const doctorMenuSections = [
    {
      label: 'QUY TRÌNH KHÁM BỆNH',
      items: [
        { key: 'doctor-reception-exam', label: 'Tiếp nhận & khám bệnh', icon: 'bi-stethoscope', href: '/nghiep-vu/tiep-nhan-kham-benh?activeMenu=doctor-reception-exam' },
        { key: 'doctor-follow-up', label: 'Tái khám', icon: 'bi-calendar-heart', href: '/nghiep-vu/tai-kham?activeMenu=doctor-follow-up' },
        { key: 'doctor-lab-orders', label: 'Chỉ định cận lâm sàng', icon: 'bi-clipboard2-plus', href: '/labtests?activeMenu=doctor-lab-orders' },
        { key: 'doctor-diagnostic-results', label: 'Đọc và đánh giá kết quả', icon: 'bi-clipboard2-data', href: '/nghiep-vu/tong-hop-ket-qua-xet-nghiem?activeMenu=doctor-diagnostic-results' },
        { key: 'doctor-final-action', label: 'Kê đơn / nhập viện / chuyển viện / ra viện', icon: 'bi-arrow-left-right', href: '/nghiep-vu/xu-tri-sau-kham?activeMenu=doctor-final-action' },
        { key: 'doctor-medical-records', label: 'Hồ sơ bệnh án', icon: 'bi-journal-medical', href: '/medical-records?activeMenu=doctor-medical-records' },
        { key: 'doctor-nurse-management', label: 'Quản lý điều dưỡng', icon: 'bi-person-badge', href: '/nghiep-vu/quan-ly-dieu-duong?activeMenu=doctor-nurse-management' }
      ]
    },
    {
      label: 'THEO DÕI & TÀI LIỆU',
      items: [
        { key: 'doctor-form-templates', label: 'Biểu mẫu', icon: 'bi-file-earmark-text', href: '/nghiep-vu/bieu-mau?activeMenu=doctor-form-templates' },
        { key: 'doctor-prescription-history', label: 'Lịch sử đơn thuốc', icon: 'bi-capsule-pill', href: '/prescriptions?activeMenu=doctor-prescription-history' }
      ]
    }
  ];
  const nurseMenuSections = [
    {
      label: 'TỔNG QUAN',
      items: [
        { key: 'nurse-dashboard', label: 'Dashboard ca trực', icon: 'bi-house-door', href: '/dashboard/nurse?activeMenu=nurse-dashboard' }
      ]
    },
    {
      label: 'CHĂM SÓC BỆNH NHÂN',
      items: [
        { key: 'nurse-vitals', label: 'Theo dõi sinh hiệu', icon: 'bi-graph-up', href: '/nghiep-vu/theo-doi-sinh-hieu?activeMenu=nurse-vitals' },
        { key: 'nurse-treatments', label: 'Thực hiện y lệnh', icon: 'bi-check2-square', href: '/treatments?activeMenu=nurse-treatments' },
        { key: 'nurse-patients', label: 'Danh sách bệnh nhân trong khoa', icon: 'bi-person', href: '/patients/list?activeMenu=nurse-patients' }
      ]
    },
    {
      label: 'QUẢN LÝ PHÒNG & GIƯỜNG',
      items: [
        { key: 'nurse-beds', label: 'Sơ đồ giường / Phòng', icon: 'bi-grid-3x3-gap', href: '/beds?activeMenu=nurse-beds' }
      ]
    },
    {
      label: 'THUỐC & VẬT TƯ',
      items: [
        { key: 'nurse-meds', label: 'Quản lý thuốc tại khoa', icon: 'bi-plus-circle', href: '/nghiep-vu/quan-ly-thuoc-tai-khoa?activeMenu=nurse-meds' },
        { key: 'nurse-supplies', label: 'Vật tư tiêu hao', icon: 'bi-hexagon', href: '/nghiep-vu/vat-tu-tieu-hao?activeMenu=nurse-supplies' }
      ]
    }
  ];
  const labMenuSections = [
    {
      label: 'VIỆN XÉT NGHIỆM',
      items: [
        { key: 'lab-orders', label: 'Nhận chỉ định xét nghiệm', icon: 'bi-clipboard2-pulse', href: '/labtests?activeMenu=lab-orders' }
      ]
    }
  ];
  const cashierMenuSections = [
    {
      label: 'TIẾP NHẬN',
      items: [
        { key: 'cashier-reception', label: 'Tiếp nhận bệnh nhân', icon: 'bi-person-plus', href: '/patients/reception?activeMenu=cashier-reception' },
        { key: 'cashier-bhyt', label: 'Kiểm tra BHYT', icon: 'bi-check2-square', href: '/bhyt?activeMenu=cashier-bhyt' },
        { key: 'cashier-appointments', label: 'Đặt lịch hẹn khám', icon: 'bi-calendar-plus', href: '/thu-ngan/dat-lich-hen-kham' },
        { key: 'cashier-queue', label: 'Quản lý hàng chờ', icon: 'bi-list-ul', href: '/thu-ngan/hang-cho' }
      ]
    },
    {
      label: 'THANH TOÁN',
      items: [
        { key: 'cashier-billing', label: 'Thanh toán viện phí', icon: 'bi-credit-card', href: '/billing?activeMenu=cashier-billing' },
        { key: 'cashier-invoices', label: 'Quản lý hóa đơn', icon: 'bi-file-earmark', href: '/nghiep-vu/hoa-don?activeMenu=cashier-invoices' },
        { key: 'cashier-print', label: 'In phiếu / Hóa đơn', icon: 'bi-printer', href: '/thu-ngan/in-phieu-hoa-don' },
        { key: 'cashier-adjustments', label: 'Hoàn tiền / Điều chỉnh', icon: 'bi-arrow-counterclockwise', href: '/thu-ngan/hoan-tien-dieu-chinh' }
      ]
    },
    {
      label: 'TRA CỨU & BÁO CÁO',
      items: [
        { key: 'cashier-patient-lookup', label: 'Tra cứu bệnh nhân', icon: 'bi-search', href: '/patients/list?activeMenu=cashier-patient-lookup' },
        { key: 'cashier-services', label: 'Danh mục dịch vụ & giá', icon: 'bi-shield', href: '/nghiep-vu/danh-muc-dich-vu?activeMenu=cashier-services' }
      ]
    }
  ];
  const patientMenuSections = [
    {
      label: 'CÁ NHÂN',
      items: [
        { key: 'patient-profile', label: 'Thông tin cá nhân', icon: 'bi-person', href: '/patients/me' }
      ]
    },
    {
      label: 'LỊCH SỬ Y TẾ',
      items: [
        { key: 'patient-history', label: 'Lịch sử khám bệnh', icon: 'bi-journal-bookmark', href: '/patients/me/treatments' },
        { key: 'patient-labs', label: 'Kết quả xét nghiệm', icon: 'bi-clipboard2-pulse', href: '/patients/me/labtests' },
        { key: 'patient-medicine', label: 'Đơn thuốc của tôi', icon: 'bi-capsule-pill', href: '/patients/me/medicines' }
      ]
    },
    {
      label: 'ĐẶT LỊCH & THANH TOÁN',
      items: [
        { key: 'patient-booking', label: 'Đặt lịch tái khám', icon: 'bi-calendar-plus', href: '/patients/me/booking' },
        { key: 'patient-billing', label: 'Hóa đơn & Thanh toán', icon: 'bi-credit-card', href: '/patients/me/billing' },
        { key: 'patient-bhyt', label: 'Thẻ BHYT của tôi', icon: 'bi-card-checklist', href: '/patients/me/bhyt' },
        { key: 'patient-discharge', label: 'Thông tin xuất viện', icon: 'bi-box-arrow-right', href: '/patients/me/discharge' }
      ]
    },
    {
      label: 'THÔNG BÁO & HỖ TRỢ',
      items: [
        { key: 'patient-notifications', label: 'Thông báo', icon: 'bi-bell', href: '/patients/me/notifications' },
        { key: 'patient-support', label: 'Yêu cầu hỗ trợ', icon: 'bi-headset', href: '/patients/me/support' }
      ]
    }
  ];
  const commonReportSection = {
    label: 'BÁO CÁO',
    items: [
      { key: 'report-statistics', label: 'Báo cáo thống kê', icon: 'bi-bar-chart', href: '/reports?activeMenu=report-statistics' }
    ]
  };
%>
<aside class="sidebar" id="appSidebar">
  <a class="brand" href="<%= isPatient ? '/patients/me' : '/dashboard/home' %>">
    <span class="brand-mark"><i class="bi bi-heart-pulse-fill"></i></span>
    <span>
      <strong>Nội trú HIS</strong>
      <small>Bệnh viện Đa khoa Việt Nam</small>
    </span>
  </a>
  <button class="sidebar-close icon-btn" type="button" data-sidebar-close aria-label="Dong menu">
    <i class="bi bi-x-lg"></i>
  </button>
  <nav class="sidebar-nav" id="sidebarBusinessMenu">
    <% if (isPatient) { %>
      <div class="px-3 py-4 mb-3 border-bottom border-white border-opacity-10">
        <div class="d-flex align-items-center mb-3">
          <div class="bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px;">
            <i class="bi bi-person text-white opacity-75"></i>
          </div>
          <span class="badge rounded-pill bg-white bg-opacity-10 border border-white border-opacity-10 fw-normal text-white-50" style="font-size: 10px; padding: 4px 10px;">
            <i class="bi bi-person-fill me-1"></i> BN - Bệnh nhân
          </span>
        </div>
        <div>
          <h6 class="text-white mb-0 fw-bold"><%= currentUser.fullName %></h6>
          <small class="text-white-50">Bệnh nhân ngoại trú</small>
        </div>
      </div>
      <% patientMenuSections.forEach(section => { %>
        <div class="nav-section-label"><%= section.label %></div>
        <% section.items.forEach(item => { %>
          <a class="nav-link <%= activeMenu === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <i class="bi <%= item.icon %>"></i>
            <span><%= item.label %></span>
          </a>
        <% }) %>
      <% }) %>
    <% } else if (isAdmin) { %>
      <div class="px-3 py-4 mb-3 border-bottom border-white border-opacity-10">
        <div>
          <h6 class="text-white mb-0 fw-bold">Admin Hệ thống</h6>
          <small class="text-white-50">Phòng CNTT</small>
        </div>
      </div>
      <% [...adminMenuSections, commonReportSection].forEach(section => { %>
        <div class="nav-section-label"><%= section.label %></div>
        <% section.items.forEach(item => { %>
          <a class="nav-link doctor-nav-link <%= activeMenu === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <i class="bi <%= item.icon %>"></i>
            <span><%= item.label %></span>
            <% if (item.badge) { %>
              <span class="badge rounded-pill bg-danger ms-auto"><%= item.badge %></span>
            <% } %>
          </a>
        <% }) %>
      <% }) %>
    <% } else if (isDoctor) { %>
      <% [...doctorMenuSections, commonReportSection].forEach(section => { %>
        <div class="nav-section-label"><%= section.label %></div>
        <% section.items.forEach(item => { %>
          <a class="nav-link doctor-nav-link <%= activeMenu === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <i class="bi <%= item.icon %>"></i>
            <span><%= item.label %></span>
            <% if (item.badge) { %>
              <span class="badge rounded-pill bg-danger ms-auto"><%= item.badge %></span>
            <% } %>
          </a>
        <% }) %>
      <% }) %>
    <% } else if (isNurse) { %>
      <div class="px-3 py-4 mb-3 border-bottom border-white border-opacity-10">
        <div class="d-flex align-items-center mb-3">
          <div class="bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px;">
            <i class="bi bi-person text-white opacity-75"></i>
          </div>
          <span class="badge rounded-pill bg-white bg-opacity-10 border border-white border-opacity-10 fw-normal text-white-50" style="font-size: 10px; padding: 4px 10px;">
            <i class="bi bi-person-fill me-1"></i> ĐD - Điều dưỡng
          </span>
        </div>
        <div>
          <h6 class="text-white mb-0 fw-bold"><%= currentUser.fullName %></h6>
          <small class="text-white-50 d-block">BS phụ trách: <%= currentUser.nurseSupervisorName || 'Chưa phân công' %></small>
          <small class="text-white-50 d-block">Khoa: <%= currentUser.supervisorDepartmentName || currentUser.departmentName || 'Chưa phân khoa' %></small>
        </div>
      </div>
      <% [...nurseMenuSections, commonReportSection].forEach(section => { %>
        <div class="nav-section-label"><%= section.label %></div>
        <% section.items.forEach(item => { %>
          <a class="nav-link doctor-nav-link <%= activeMenu === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <i class="bi <%= item.icon %>"></i>
            <span><%= item.label %></span>
            <% if (item.badge) { %>
              <span class="badge rounded-pill bg-danger ms-auto"><%= item.badge %></span>
            <% } %>
          </a>
        <% }) %>
      <% }) %>
    <% } else if (isLab) { %>
      <div class="px-3 py-4 mb-3 border-bottom border-white border-opacity-10">
        <div>
          <h6 class="text-white mb-0 fw-bold"><%= currentUser.fullName %></h6>
          <small class="text-white-50">Viện xét nghiệm</small>
        </div>
      </div>
      <% [...labMenuSections, commonReportSection].forEach(section => { %>
        <div class="nav-section-label"><%= section.label %></div>
        <% section.items.forEach(item => { %>
          <a class="nav-link doctor-nav-link <%= activeMenu === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <i class="bi <%= item.icon %>"></i>
            <span><%= item.label %></span>
          </a>
        <% }) %>
      <% }) %>
    <% } else if (isReceptionist) { %>
      <div class="px-3 py-4 mb-3 border-bottom border-white border-opacity-10">
        <div>
          <h6 class="text-white mb-0 fw-bold"><%= currentUser.fullName %></h6>
          <small class="text-white-50">Phòng Tiếp nhận</small>
        </div>
      </div>
      <% [...cashierMenuSections, commonReportSection].forEach(section => { %>
        <div class="nav-section-label"><%= section.label %></div>
        <% section.items.forEach(item => { %>
          <a class="nav-link doctor-nav-link <%= activeMenu === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <i class="bi <%= item.icon %>"></i>
            <span><%= item.label %></span>
            <% if (item.badge) { %>
              <span class="badge rounded-pill bg-danger ms-auto"><%= item.badge %></span>
            <% } %>
          </a>
        <% }) %>
      <% }) %>
    <% } else { %>
      <a class="nav-link <%= activeMenu === 'dashboard' ? 'active' : '' %>" href="/dashboard/home">
        <i class="bi bi-grid-1x2-fill"></i>
        <span>Tổng quan</span>
      </a>
      <% 
        let activeGroupFound = false;
        businessGroups.filter(canGroup).forEach(group => { 
          const visibleItems = group.items.filter(item => canItem(item, group));
          let isOpen = false;
          if (!activeGroupFound) {
            isOpen = visibleItems.some(item => activeMenu === item.key);
            if (isOpen) activeGroupFound = true;
          }
          const collapseId = `businessGroup${group.code}`;
        %>
        <button
          class="nav-section nav-section-toggle <%= isOpen ? '' : 'collapsed' %>"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#<%= collapseId %>"
          aria-expanded="<%= isOpen ? 'true' : 'false' %>"
          aria-controls="<%= collapseId %>">
          <span class="nav-section-left">
            <i class="bi <%= group.icon %>"></i>
            <span><%= group.code %>. <%= group.title %></span>
          </span>
          <i class="bi bi-chevron-down nav-section-chevron"></i>
        </button>
        <div class="collapse <%= isOpen ? 'show' : '' %>" id="<%= collapseId %>">
          <div class="nav-child-group">
            <% visibleItems.forEach(item => { 
              const linkHref = item.href.includes('?') ? `${item.href}&activeMenu=${item.key}` : `${item.href}?activeMenu=${item.key}`;
            %>
              <a class="nav-link nav-child <%= activeMenu === item.key ? 'active' : '' %>" href="<%= linkHref %>">
                <i class="bi <%= item.icon %>"></i>
                <span><%= item.code %> <%= item.title %></span>
              </a>
            <% }) %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    <span class="status-dot"></span>
    <span><%= databaseStatusLabel || 'SQL Server' %></span>
  </div>
</aside>
