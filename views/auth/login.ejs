<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Đăng nhập hệ thống | QuanLyKhamChuaBenhNoiTru</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --primary: #0284c7;
      --secondary: #0f766e;
      --text-color: #1e293b;
      --muted-color: #64748b;
      --card-bg: rgba(255, 255, 255, 0.9);
      --input-bg: #f8fafc;
      --gradient: linear-gradient(135deg, #0284c7 0%, #0f766e 100%);
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Be Vietnam Pro', sans-serif;
      background: radial-gradient(circle at 70% 20%, rgba(2, 132, 199, 0.15), transparent 500px),
                  radial-gradient(circle at 10% 80%, rgba(15, 118, 110, 0.15), transparent 500px),
                  #f1f5f9;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--text-color);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='800' height='800' viewBox='0 0 800 800' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M400 0C179.086 0 0 179.086 0 400s179.086 400 400 400 400-179.086 400-400S620.914 0 400 0zm0 760C201.177 760 40 598.823 40 400S201.177 40 400 40s360 161.177 360 360-161.177 360-360 360z' fill='%230284c7' fill-opacity='0.03'/%3E%3C/svg%3E");
      background-size: 1200px;
      background-position: center;
      background-repeat: no-repeat;
      pointer-events: none;
      z-index: -1;
    }

    .login-shell {
      width: 100%;
      max-width: 960px;
      padding: 20px;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(420px, 480px) minmax(280px, 340px);
      gap: 24px;
      align-items: center;
      justify-content: center;
    }

    .login-container {
      width: 100%;
    }

    .login-card {
      background: var(--card-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 40px;
      padding: 56px 48px;
      box-shadow: 0 40px 80px rgba(15, 23, 42, 0.1);
    }

    .login-header h1 {
      font-size: 32px;
      font-weight: 800;
      margin-bottom: 12px;
      color: #0f172a;
    }

    .login-header p {
      color: var(--muted-color);
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 48px;
    }

    .form-group {
      margin-bottom: 24px;
    }

    .form-label {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.1em;
      color: var(--muted-color);
      margin-bottom: 12px;
      text-transform: uppercase;
    }

    .input-group-custom {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-group-custom > i:not(.password-toggle) {
      position: absolute;
      left: 18px;
      color: var(--primary);
      font-size: 18px;
      pointer-events: none;
      z-index: 2;
    }

    .input-group-custom .form-control {
      background: var(--input-bg);
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      color: var(--text-color);
      padding: 14px 50px 14px 50px;
      font-size: 16px;
      height: 58px;
      transition: all 0.3s ease;
      position: relative;
      z-index: 1;
    }

    .input-group-custom .form-control:focus {
      background: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.1);
      outline: none;
    }

    .input-group-custom .form-control::placeholder {
      color: #94a3b8;
    }

    .password-toggle {
      position: absolute;
      right: 18px;
      color: var(--muted-color);
      cursor: pointer;
      transition: color 0.2s;
      z-index: 3;
      font-size: 18px;
    }

    .password-toggle:hover {
      color: var(--primary);
    }

    .btn-login {
      background: var(--gradient);
      border: none;
      border-radius: 20px;
      color: #ffffff;
      width: 100%;
      height: 64px;
      font-size: 18px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: 40px;
      box-shadow: 0 12px 30px rgba(2, 132, 199, 0.3);
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .btn-login:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 40px rgba(2, 132, 199, 0.4);
      filter: brightness(1.05);
    }

    .auth-links {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      margin-top: 32px;
      font-size: 14px;
    }

    .auth-links a {
      color: var(--primary);
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
    }

    .auth-links a:hover {
      color: var(--secondary);
      text-decoration: underline;
    }

    .auth-links .dot {
      width: 4px;
      height: 4px;
      background: #cbd5e1;
      border-radius: 50%;
    }

    .login-footer {
      margin-top: 48px;
      color: #94a3b8;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .alert-custom {
      border-radius: 16px;
      padding: 14px 20px;
      margin-bottom: 24px;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid transparent;
    }

    .alert-custom.error {
      background: #fff1f2;
      border-color: #fecdd3;
      color: #e11d48;
    }

    .alert-custom.success {
      background: #f0fdf4;
      border-color: #bbf7d0;
      color: #16a34a;
    }

    .sample-account-card {
      background: rgba(255, 255, 255, 0.82);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(226, 232, 240, 0.92);
      border-radius: 28px;
      padding: 24px;
      box-shadow: 0 28px 60px rgba(15, 23, 42, 0.08);
    }

    .sample-account-card h2 {
      margin: 0 0 8px;
      color: #0f172a;
      font-size: 20px;
      font-weight: 800;
    }

    .sample-account-card p {
      margin: 0 0 18px;
      color: var(--muted-color);
      font-size: 13px;
      line-height: 1.5;
    }

    .sample-account-list {
      display: grid;
      gap: 9px;
    }

    .sample-account-btn {
      width: 100%;
      display: grid;
      grid-template-columns: 34px 1fr;
      gap: 10px;
      align-items: center;
      padding: 11px 12px;
      border: 1px solid #dbe7f3;
      border-radius: 14px;
      background: #ffffff;
      color: var(--text-color);
      text-align: left;
      transition: all 0.18s ease;
    }

    .sample-account-btn:hover {
      border-color: var(--primary);
      background: #f8fbff;
      transform: translateY(-1px);
    }

    .sample-account-btn i {
      width: 34px;
      height: 34px;
      display: inline-grid;
      place-items: center;
      border-radius: 12px;
      background: #e0f2fe;
      color: var(--primary);
      font-size: 16px;
    }

    .sample-account-btn strong,
    .sample-account-btn small {
      display: block;
    }

    .sample-account-btn strong {
      font-size: 14px;
      font-weight: 800;
    }

    .sample-account-btn small {
      margin-top: 2px;
      color: var(--muted-color);
      font-size: 12px;
      font-weight: 600;
    }

    @media (max-width: 860px) {
      .login-shell {
        max-width: 520px;
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      body {
        justify-content: flex-start;
        padding: 18px 0 24px;
      }

      .login-shell {
        padding: 12px;
      }

      .login-card {
        padding: 30px 20px;
        border-radius: 24px;
      }

      .login-header h1 {
        font-size: 26px;
      }

      .login-header p {
        margin-bottom: 30px;
      }

      .input-group-custom .form-control {
        height: 52px;
        font-size: 15px;
      }

      .btn-login {
        height: 54px;
        margin-top: 28px;
        font-size: 16px;
      }

      .auth-links {
        flex-direction: column;
        gap: 8px;
        margin-top: 24px;
        text-align: center;
      }

      .auth-links .dot {
        display: none;
      }

      .login-footer {
        width: min(100% - 24px, 480px);
        margin-top: 18px;
        align-items: flex-start;
      }

      .sample-account-card {
        padding: 18px;
        border-radius: 22px;
      }
    }

    /* Animation cho việc vào trang */
    .auth-motion-card {
      animation: auth-slide-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    
    .auth-motion-stagger > * {
      opacity: 0;
      animation: auth-fade-in 0.5s ease-out forwards;
    }

    @keyframes auth-slide-up {
      from { opacity: 0; transform: translateY(30px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes auth-fade-in {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .auth-motion-stagger > *:nth-child(1) { animation-delay: 0.1s; }
    .auth-motion-stagger > *:nth-child(2) { animation-delay: 0.2s; }
    .auth-motion-stagger > *:nth-child(3) { animation-delay: 0.3s; }
    .auth-motion-stagger > *:nth-child(4) { animation-delay: 0.4s; }
    .auth-motion-stagger > *:nth-child(5) { animation-delay: 0.5s; }
  </style>
</head>
<body>
  <div class="login-shell auth-motion-page">
    <div class="login-container">
      <div class="login-card auth-motion-card">
        <div class="login-header text-center auth-motion-stagger">
          <h1>Đăng nhập hệ thống</h1>
          <p>Nhập tài khoản được cấp để vào khu làm việc phù hợp.</p>
        </div>

        <% if (flash && flash.error && flash.error.length) { %>
          <% flash.error.forEach(message => { %>
            <div class="alert-custom error auth-motion-stagger">
              <i class="bi bi-exclamation-triangle"></i>
              <%= message %>
            </div>
          <% }) %>
        <% } %>

        <% if (flash && flash.success && flash.success.length) { %>
          <% flash.success.forEach(message => { %>
            <div class="alert-custom success auth-motion-stagger">
              <i class="bi bi-check-circle"></i>
              <%= message %>
            </div>
          <% }) %>
        <% } %>

        <form action="/login" method="post" class="auth-motion-stagger">
          <div class="form-group">
            <label class="form-label">TÀI KHOẢN</label>
            <div class="input-group-custom">
              <i class="bi bi-person"></i>
              <input class="form-control" id="loginField" name="login" placeholder="Username hoặc email" required autofocus>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">MẬT KHẨU</label>
            <div class="input-group-custom">
              <i class="bi bi-lock"></i>
              <input class="form-control" id="passwordField" name="password" type="password" placeholder="Nhập mật khẩu" required>
              <i class="bi bi-eye password-toggle" id="togglePassword"></i>
            </div>
          </div>

          <button class="btn btn-login" type="submit">
            <i class="bi bi-box-arrow-in-right"></i>
            Đăng nhập
          </button>
        </form>

        <div class="auth-links auth-motion-stagger">
          <a href="/forgot-password">Quên mật khẩu?</a>
          <div class="dot"></div>
          <a href="/register">Đăng ký tài khoản bệnh nhân</a>
        </div>
      </div>
    </div>

    <aside class="sample-account-card auth-motion-card" aria-label="Tài khoản mẫu">
      <h2>Tài khoản mẫu</h2>
      <p>Chọn nhanh tài khoản để tự động điền thông tin đăng nhập.</p>
      <div class="sample-account-list">
        <button type="button" class="sample-account-btn" data-demo-login="admin" data-demo-password="123456">
          <i class="bi bi-shield-check"></i>
          <span><strong>Admin</strong><small>admin / 123456</small></span>
        </button>
        <button type="button" class="sample-account-btn" data-demo-login="benhnhan" data-demo-password="123456">
          <i class="bi bi-person-heart"></i>
          <span><strong>Bệnh nhân</strong><small>benhnhan / 123456</small></span>
        </button>
        <button type="button" class="sample-account-btn" data-demo-login="duoc" data-demo-password="123456">
          <i class="bi bi-capsule-pill"></i>
          <span><strong>Dược</strong><small>duoc / 123456</small></span>
        </button>
        <button type="button" class="sample-account-btn" data-demo-login="vienxetnghiem" data-demo-password="123456">
          <i class="bi bi-clipboard2-pulse"></i>
          <span><strong>Viện xét nghiệm</strong><small>vienxetnghiem / 123456</small></span>
        </button>
        <button type="button" class="sample-account-btn" data-demo-login="dieuduong" data-demo-password="123456">
          <i class="bi bi-heart-pulse"></i>
          <span><strong>Điều dưỡng</strong><small>dieuduong / 123456</small></span>
        </button>
        <button type="button" class="sample-account-btn" data-demo-login="thungan" data-demo-password="123456">
          <i class="bi bi-receipt"></i>
          <span><strong>Tiếp nhận / Thu ngân</strong><small>thungan / 123456</small></span>
        </button>
      </div>
    </aside>
  </div>

  <div class="login-footer auth-motion-stagger">
    <i class="bi bi-shield-check"></i>
    <span>Kết nối được mã hóa SSL · Phiên bản 3.2.1</span>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/motion@11.11.18/dist/motion.js"></script>
  <script src="/js/auth-motion.js"></script>

  <script>
    const togglePassword = document.querySelector('#togglePassword');
    const login = document.querySelector('#loginField');
    const password = document.querySelector('#passwordField');

    togglePassword.addEventListener('click', function (e) {
      const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
      password.setAttribute('type', type);
      this.classList.toggle('bi-eye');
      this.classList.toggle('bi-eye-slash');
    });

    document.querySelectorAll('[data-demo-login]').forEach((button) => {
      button.addEventListener('click', () => {
        login.value = button.dataset.demoLogin || '';
        password.value = button.dataset.demoPassword || '';
        login.dispatchEvent(new Event('input', { bubbles: true }));
        password.dispatchEvent(new Event('input', { bubbles: true }));
        password.focus();
      });
    });
  </script>
</body>
</html>
