<%
  const record = data.record;
%>
<section class="detail-hero">
  <div>
    <h2><%= record.full_name %></h2>
    <p><%= record.gender %> · <%= format.age(record.date_of_birth) %> tuổi · <%= record.department_name %></p>
  </div>
  <a href="/medical-records" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Quay lại</a>
</section>

<ul class="nav nav-pills gap-2 mt-4">
  <li class="nav-item"><a class="nav-link active" href="#recordClinical">Hồ sơ điều trị</a></li>
  <li class="nav-item"><a class="nav-link" href="#recordCosts">Chi phí điều trị</a></li>
</ul>

<section class="dashboard-grid mt-4" id="recordClinical">
  <div class="panel">
    <div class="panel-header"><h2>Thông tin bệnh án</h2></div>
    <dl class="info-list">
      <dt>Chẩn đoán nhập viện</dt><dd><%= record.diagnosis_on_admission %></dd>
      <dt>Tiền sử bệnh</dt><dd><%= record.medical_history %></dd>
      <dt>Dị ứng</dt><dd><%= record.allergies %></dd>
      <dt>Dấu hiệu sinh tồn</dt><dd><%= record.vital_signs %></dd>
      <dt>Ghi chú bác sĩ</dt><dd><%= record.doctor_notes %></dd>
    </dl>
  </div>
  <div class="panel">
    <div class="panel-header"><h2>Kết quả xét nghiệm gần nhất</h2></div>
    <div class="list-stack">
      <% data.labs.slice(0, 4).forEach(lab => { %>
        <div class="list-item">
          <span class="list-icon info"><i class="bi bi-clipboard2-data"></i></span>
          <div><strong><%= lab.testType %></strong><small><%= lab.resultSummary || 'Chưa có kết quả' %></small></div>
          <%- include('../partials/badge', { text: lab.status }) %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="panel mt-4" id="recordCosts">
  <div class="panel-header">
    <div>
      <h2>Chi phí điều trị</h2>
      <small>Chi phí phát sinh từ thuốc, xét nghiệm và dịch vụ/y lệnh đã thực hiện.</small>
    </div>
  </div>
  <div class="module-table-wrap">
    <table class="table app-table">
      <thead>
        <tr>
          <th>Ngày phát sinh</th>
          <th>Loại chi phí</th>
          <th>Nội dung</th>
          <th>Khoa/phòng</th>
          <th>Người ghi nhận</th>
          <th>Số lượng</th>
          <th>Đơn giá</th>
          <th>Thành tiền</th>
          <th>Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% data.costs.forEach(cost => { %>
          <tr>
            <td><%= format.datetime(cost.incurredAt) %></td>
            <td><%= cost.costType %></td>
            <td class="text-wrap-cell compact"><%= cost.content %></td>
            <td><%= cost.departmentName || '-' %></td>
            <td><%= cost.recordedBy || '-' %></td>
            <td><%= Number(cost.quantity || 0).toLocaleString('vi-VN') %></td>
            <td><%= format.currency(cost.unitPrice || 0) %></td>
            <td><strong><%= format.currency(cost.amount || 0) %></strong></td>
            <td><%- include('../partials/badge', { text: cost.status }) %></td>
          </tr>
        <% }) %>
        <% if (!data.costs.length) { %>
          <tr><td colspan="9" class="text-center py-4 text-muted">Chưa có chi phí điều trị phát sinh.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<section class="dashboard-grid mt-4">
  <div class="panel">
    <div class="panel-header"><h2>Danh sách thuốc</h2></div>
    <div class="table-responsive">
      <table class="table app-table"><thead><tr><th>Thuốc</th><th>Liều</th><th>Lần dùng</th><th>Đường dùng</th><th>Thời gian</th></tr></thead><tbody>
        <% data.medicines.forEach(item => { %>
          <tr><td><%= item.medicineName %></td><td><%= item.dosage %></td><td><%= item.frequency %></td><td><%= item.route %></td><td><%= format.date(item.startDate) %> - <%= format.date(item.endDate) %></td></tr>
        <% }) %>
      </tbody></table>
    </div>
  </div>
  <div class="panel">
    <div class="panel-header"><h2>Timeline diễn biến điều trị</h2></div>
    <div class="timeline">
      <% data.treatments.forEach(item => { %>
        <div class="timeline-item">
          <span></span>
          <div>
            <strong><%= format.datetime(item.scheduledTime) %> · <%= item.treatmentContent %></strong>
            <p><%= item.assigneeName %> · <%= item.note || 'Không có ghi chú' %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
