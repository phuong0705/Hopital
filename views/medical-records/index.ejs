<%
  const recordFilters = locals.filters || {};
  const pager = locals.pagination || { page: 1, pageSize: 10, totalRows: rows.length, totalPages: 1 };
  const menuKey = activeMenu || 'medical-records';
  const roleCode = currentUser ? currentUser.roleCode : '';
  const canTransferFromRecord = Boolean(locals.canTransferRoomBed) && roleCode === 'NURSE';

  function formatCareLocation(row) {
    const department = row.departmentName || 'Chưa phân khoa';
    const roomBed = row.roomCode || row.bedCode
      ? [row.roomCode || 'Chưa xếp buồng', row.bedCode || 'Chưa xếp giường'].join(' · ')
      : 'Chưa xếp buồng/giường';
    return `${department} · ${roomBed}`;
  }

  function pageHref(page) {
    const params = new URLSearchParams();
    params.set('activeMenu', menuKey);
    if (recordFilters.q) params.set('q', recordFilters.q);
    if (recordFilters.status) params.set('status', recordFilters.status);
    params.set('page', page);
    return `/medical-records?${params.toString()}`;
  }

  const pageStart = pager.totalRows ? ((pager.page - 1) * pager.pageSize) + 1 : 0;
  const pageEnd = Math.min(pager.page * pager.pageSize, pager.totalRows);
  const pageNumbers = [];
  for (let pageNo = Math.max(1, pager.page - 2); pageNo <= Math.min(pager.totalPages, pager.page + 2); pageNo += 1) {
    pageNumbers.push(pageNo);
  }
%>

<section class="module-hero">
  <div>
    <h2>Hồ sơ bệnh án</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-light" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light" type="button" data-export-table="medicalRecordsCompletionTable" data-filename="hoan-tat-ho-so-benh-an.csv">
      <i class="bi bi-filetype-csv me-2"></i>CSV
    </button>
  </div>
</section>

<% if (canTransferFromRecord) { %>
  <%- include('../partials/action-modals', { activeAdmissions, availableBeds, transferReturnTo }) %>
<% } %>

<section class="panel module-panel mt-4">
  <form class="module-toolbar medical-record-filter-toolbar" method="get" action="/medical-records">
    <input type="hidden" name="activeMenu" value="<%= menuKey %>">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" name="q" type="search" value="<%= recordFilters.q || '' %>" placeholder="Tìm bệnh nhân, mã HSBA, chẩn đoán, bác sĩ">
    </div>
    <select class="form-select" name="status">
      <option value="">Tất cả trạng thái</option>
      <% ['Đang điều trị', 'Đang chờ xuất viện', 'Đã xuất viện'].forEach(status => { %>
        <option value="<%= status %>" <%= recordFilters.status === status ? 'selected' : '' %>><%= status %></option>
      <% }) %>
    </select>
    <button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-2"></i>Lọc</button>
    <% if (recordFilters.q || recordFilters.status) { %>
      <a class="btn btn-light" href="/medical-records?activeMenu=<%= menuKey %>">Xóa lọc</a>
    <% } %>
  </form>

  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 text-muted small">
    <span>Hiển thị <strong><%= pageStart %>-<%= pageEnd %></strong> / <strong><%= pager.totalRows %></strong> hồ sơ</span>
    <span>Mỗi trang <%= pager.pageSize %> hồ sơ</span>
  </div>

  <div class="d-flex flex-column gap-3">
    <% rows.forEach(row => {
      const location = formatCareLocation(row);
    %>
      <article
        class="border rounded-3 bg-white p-3 medical-record-summary-card"
        data-table-row="medicalRecordsCompletionTable"
        data-search="<%= `${row.recordCode} ${row.patientCode} ${row.patientName} ${row.doctorName || ''} ${row.recordAdmissionState}`.toLowerCase() %>"
        data-state="<%= row.recordAdmissionState %>">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
          <h4 class="mb-0"><%= row.patientName %></h4>
          <span class="module-soft-pill"><%= row.patientCode %> · <%= row.gender || '-' %></span>
          <%- include('../partials/badge', { text: row.recordAdmissionState }) %>
          <div class="ms-auto d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-light" href="/medical-records/<%= row.recordId %>?activeMenu=<%= menuKey %>">
              <i class="bi bi-journal-text me-1"></i> Xem HSBA
            </a>
            <% if (canTransferFromRecord && row.admissionId && row.recordAdmissionState !== 'Đã xuất viện') { %>
              <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#transferModal"
                data-admission-id="<%= row.admissionId %>"
                data-patient-name="<%= row.patientName %>"
                data-patient-code="<%= row.patientCode %>">
                <i class="bi bi-arrow-left-right me-1"></i> Chuyển phòng / giường
              </button>
            <% } %>
          </div>
        </div>
        <div class="medical-record-summary-grid">
          <div>
            <span class="fw-semibold text-dark d-block">Hồ sơ:</span>
            <span class="text-muted"><%= row.recordCode || '-' %></span>
          </div>
          <div>
            <span class="fw-semibold text-dark d-block">Khoa/Buồng/Giường:</span>
            <span class="text-muted"><%= location %></span>
          </div>
          <div>
            <span class="fw-semibold text-dark d-block">Bác sĩ:</span>
            <span class="text-muted"><%= row.doctorName || '-' %></span>
          </div>
          <div>
            <span class="fw-semibold text-dark d-block">Đơn thuốc:</span>
            <span class="text-muted"><%= row.prescriptionCount || 0 %></span>
          </div>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="module-table-wrap visually-hidden">
    <table class="table app-table module-table medical-records-completion-table" id="medicalRecordsCompletionTable">
      <colgroup>
        <col class="mr-col-record">
        <col class="mr-col-patient">
        <col class="mr-col-type">
        <col class="mr-col-checks">
        <col class="mr-col-result">
        <col class="mr-col-status">
        <col class="mr-col-actions">
      </colgroup>
      <thead>
        <tr>
          <th>Hồ sơ</th>
          <th>Bệnh nhân</th>
          <th>Phân loại</th>
          <th>Điều kiện chốt</th>
          <th>Kết luận lượt điều trị</th>
          <th>Trạng thái</th>
          <th class="text-end no-export">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => {
          const location = formatCareLocation(row);
          const canSubmitComplete = canCompleteRecord && row.completionState === 'Sẵn sàng hoàn tất';
        %>
          <tr
            data-search="<%= `${row.recordCode} ${row.patientCode} ${row.patientName} ${row.doctorName || ''} ${row.recordAdmissionState}`.toLowerCase() %>"
            data-state="<%= row.recordAdmissionState %>"
            data-admission-state="<%= row.recordAdmissionState %>">
            <td>
              <div class="module-primary">
                <strong><%= row.recordCode %></strong>
                <small>Tạo ngày <%= format.date(row.createdAt) %></small>
              </div>
            </td>
            <td class="text-wrap-cell">
              <div><strong><%= row.patientName %></strong></div>
              <div class="small text-muted"><%= row.patientCode %> · <%= location %></div>
              <div class="small text-muted"><%= row.doctorName || 'Chưa gán bác sĩ' %></div>
            </td>
            <td><%- include('../partials/badge', { text: row.recordAdmissionState }) %></td>
            <td class="text-wrap-cell">
              <div class="d-flex flex-wrap gap-2 mb-2">
                <span class="badge bg-light text-dark border">CLS <%= Number(row.labCount || 0) - Number(row.pendingLabCount || 0) %>/<%= row.labCount || 0 %></span>
                <span class="badge bg-light text-dark border">Y lệnh <%= Number(row.treatmentCount || 0) - Number(row.pendingTreatmentCount || 0) %>/<%= row.treatmentCount || 0 %></span>
                <span class="badge bg-light text-dark border">Đơn thuốc <%= row.prescriptionCount || 0 %></span>
              </div>
              <% if (row.missingItems.length) { %>
                <div class="small text-muted"><%= row.missingItems.join(' · ') %></div>
              <% } else { %>
                <div class="small text-success fw-semibold">Đủ điều kiện hành chính và chuyên môn</div>
              <% } %>
            </td>
            <td class="text-wrap-cell">
              <div><%= row.dischargeId ? 'Đã có hồ sơ ra viện' : row.admissionStatus %></div>
              <% if (row.dischargeDate) { %>
                <small class="text-muted"><%= format.datetime(row.dischargeDate) %> · <%= row.dischargePaymentStatus || 'Chưa cập nhật thanh toán' %></small>
              <% } else { %>
                <small class="text-muted">Nhập viện <%= format.datetime(row.admissionDate) %></small>
              <% } %>
            </td>
            <td>
              <div class="d-flex flex-column gap-2 align-items-start">
                <%- include('../partials/badge', { text: row.completionState }) %>
                <%- include('../partials/badge', { text: row.status }) %>
              </div>
            </td>
            <td class="text-end no-export">
              <div class="table-actions justify-content-end">
                <a class="btn btn-sm btn-light action-icon" href="/medical-records/<%= row.recordId %>?activeMenu=<%= menuKey %>" data-bs-toggle="tooltip" title="Xem HSBA">
                  <i class="bi bi-journal-text"></i>
                </a>
                <% if (canCompleteRecord) { %>
                  <form action="/medical-records/<%= row.recordId %>/complete" method="post" class="d-inline">
                    <input type="hidden" name="returnTo" value="<%= pageHref(pager.page) %>">
                    <button class="btn btn-sm <%= canSubmitComplete ? 'btn-primary' : 'btn-light' %> action-icon" type="submit" <%= canSubmitComplete ? '' : 'disabled' %> data-bs-toggle="tooltip" title="Hoàn tất HSBA">
                      <i class="bi bi-check2-square"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!rows.length) { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">Chưa có hồ sơ bệnh án trong phạm vi phụ trách.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="empty-inline module-empty <%= rows.length ? 'd-none' : '' %>" data-empty-for="medicalRecordsCompletionTable">
    <i class="bi bi-search"></i>
    <strong>Không tìm thấy hồ sơ phù hợp</strong>
  </div>

  <% if (pager.totalPages > 1) { %>
    <nav class="mt-4" aria-label="Phân trang hồ sơ bệnh án">
      <ul class="pagination justify-content-end mb-0">
        <li class="page-item <%= pager.page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="<%= pager.page <= 1 ? '#' : pageHref(pager.page - 1) %>">Trước</a>
        </li>
        <% if (!pageNumbers.includes(1)) { %>
          <li class="page-item"><a class="page-link" href="<%= pageHref(1) %>">1</a></li>
          <% if (pageNumbers[0] > 2) { %>
            <li class="page-item disabled"><span class="page-link">...</span></li>
          <% } %>
        <% } %>
        <% pageNumbers.forEach(pageNo => { %>
          <li class="page-item <%= pageNo === pager.page ? 'active' : '' %>">
            <a class="page-link" href="<%= pageHref(pageNo) %>"><%= pageNo %></a>
          </li>
        <% }) %>
        <% if (!pageNumbers.includes(pager.totalPages)) { %>
          <% if (pageNumbers[pageNumbers.length - 1] < pager.totalPages - 1) { %>
            <li class="page-item disabled"><span class="page-link">...</span></li>
          <% } %>
          <li class="page-item"><a class="page-link" href="<%= pageHref(pager.totalPages) %>"><%= pager.totalPages %></a></li>
        <% } %>
        <li class="page-item <%= pager.page >= pager.totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="<%= pager.page >= pager.totalPages ? '#' : pageHref(pager.page + 1) %>">Sau</a>
        </li>
      </ul>
    </nav>
  <% } %>
</section>
