<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Quản lý khám chữa bệnh nội trú</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css" rel="stylesheet">
  <link href="/css/app.css?v=4" rel="stylesheet">
  <link href="/css/clinical-vibe.css?v=3" rel="stylesheet">
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <div class="mobile-sidebar-backdrop" data-sidebar-close aria-hidden="true"></div>
    <div class="app-main">
      <%- include('../partials/topbar') %>
      <main class="content-wrap">
        <div class="page-loading-skeleton" id="pageLoadingSkeleton" aria-hidden="true">
          <div class="page-skeleton-hero">
            <span class="page-skeleton-icon"></span>
            <div>
              <span class="page-skeleton-line w-56"></span>
              <span class="page-skeleton-line w-36"></span>
            </div>
          </div>
          <div class="page-skeleton-toolbar">
            <span class="page-skeleton-line w-32"></span>
            <span class="page-skeleton-line w-28"></span>
            <span class="page-skeleton-line w-24"></span>
            <span class="page-skeleton-line w-20"></span>
          </div>
          <div class="page-skeleton-grid">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="page-skeleton-table">
            <% for (let index = 0; index < 6; index += 1) { %>
              <span></span>
            <% } %>
          </div>
        </div>
        <%- include('../partials/flash') %>
        <%- body %>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/app.js?v=4"></script>
</body>
</html>
