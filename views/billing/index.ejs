<% const canCollectPayment = currentUser && ['ADMIN', 'RECEPTIONIST'].includes(currentUser.roleCode); %>

<section class="module-hero">
  <div>
    <h2>Tổng hợp viện phí</h2>
  </div>
  <div class="module-actions">
    <button class="btn btn-light" type="button" data-print-page><i class="bi bi-printer me-2"></i>In</button>
    <button class="btn btn-light" type="button" data-export-table="billingSummaryTable" data-filename="tong-hop-vien-phi.csv"><i class="bi bi-filetype-csv me-2"></i>CSV</button>
  </div>
</section>

<section class="panel module-panel mt-4">
  <div class="module-toolbar">
    <div class="module-search">
      <i class="bi bi-search"></i>
      <input class="form-control" type="search" placeholder="Tìm bệnh nhân, mã BN, khoa hoặc bác sĩ" data-module-search="billingSummaryTable">
    </div>
  </div>

  <div class="module-table-wrap">
    <table class="table app-table module-table billing-table" id="billingSummaryTable">
      <thead>
        <tr>
          <th>Bệnh nhân</th>
          <th>Khoa / bác sĩ</th>
          <th>Chờ thực hiện</th>
          <th>Đến hạn thu</th>
          <th>Đã thanh toán</th>
          <th>Phát sinh gần nhất</th>
          <% if (canCollectPayment) { %>
            <th class="text-end">Thao tác</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => {
          const rowPayableAmount = Number(row.payableAmount || 0);
          const canConfirmDischarge = row.admissionStatus === 'Chờ xuất viện'
            && Number(row.hasDischargeRecord || 0) === 1
            && rowPayableAmount <= 0;
        %>
          <tr data-search="<%= `${row.patientCode} ${row.patientName} ${row.departmentName} ${row.doctorName}`.toLowerCase() %>">
            <td>
              <div class="module-primary">
                <strong><%= row.patientName %></strong>
                <small><%= row.patientCode %></small>
              </div>
            </td>
            <td>
              <%= row.departmentName %>
              <small><%= row.doctorName %></small>
            </td>
            <td><%= format.currency(row.waitingAmount || 0) %></td>
            <td><strong class="module-money"><%= format.currency(row.payableAmount || 0) %></strong></td>
            <td><%= format.currency(row.paidAmount || 0) %></td>
            <td><%= row.latestCostAt ? format.datetime(row.latestCostAt) : '-' %></td>
            <% if (canCollectPayment) { %>
              <td class="text-end">
                <div class="d-inline-flex gap-2">
                  <button class="btn btn-sm btn-light" type="button" data-bs-toggle="modal" data-bs-target="#costModal<%= row.admissionId %>">
                    Chi tiết
                  </button>
                  <% if (rowPayableAmount > 0) { %>
                    <form action="/billing/admissions/<%= row.admissionId %>/notify" method="post" class="d-inline">
                      <button class="btn btn-sm btn-outline-primary" type="submit">
                        <i class="bi bi-bell me-1"></i>Nhắc phí
                      </button>
                    </form>
                  <% } else if (canConfirmDischarge) { %>
                    <form action="/billing/admissions/<%= row.admissionId %>/confirm-discharge" method="post" class="d-inline">
                      <button class="btn btn-sm btn-success" type="submit">
                        <i class="bi bi-box-arrow-right me-1"></i>Xác nhận xuất viện
                      </button>
                    </form>
                  <% } else { %>
                    <button class="btn btn-sm btn-light" type="button" disabled>
                      Chưa có phí đến hạn
                    </button>
                  <% } %>
                </div>
              </td>
            <% } %>
          </tr>
        <% }) %>
        <% if (!rows.length) { %>
          <tr><td colspan="<%= canCollectPayment ? 7 : 6 %>" class="text-center py-4 text-muted">Chưa có chi phí điều trị phát sinh.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<% if (canCollectPayment) rows.forEach(row => {
  const costs = costGroups[row.admissionId] || [];
  const payableAmount = Number(row.payableAmount || 0);
%>
  <div class="modal fade" id="costModal<%= row.admissionId %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content app-modal">
        <div class="modal-header">
          <div>
            <h5 class="modal-title">Chi phí điều trị - <%= row.patientName %></h5>
            <small class="text-muted"><%= row.patientCode %> · <%= row.departmentName %></small>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="module-table-wrap">
            <table class="table app-table">
              <thead>
                <tr>
                  <th>Ngày phát sinh</th>
                  <th>Loại chi phí</th>
                  <th>Nội dung</th>
                  <th>Khoa/phòng</th>
                  <th>Người ghi nhận</th>
                  <th>Số lượng</th>
                  <th>Đơn giá</th>
                  <th>Thành tiền</th>
                  <th>Trạng thái</th>
                </tr>
              </thead>
              <tbody>
                <% costs.forEach(cost => { %>
                  <tr>
                    <td><%= format.datetime(cost.incurredAt) %></td>
                    <td><%= cost.costType %></td>
                    <td class="text-wrap-cell compact"><%= cost.content %></td>
                    <td><%= cost.departmentName || '-' %></td>
                    <td><%= cost.recordedBy || '-' %></td>
                    <td><%= Number(cost.quantity || 0).toLocaleString('vi-VN') %></td>
                    <td><%= format.currency(cost.unitPrice || 0) %></td>
                    <td><strong><%= format.currency(cost.amount || 0) %></strong></td>
                    <td><%- include('../partials/badge', { text: cost.status }) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-footer justify-content-between">
          <div>
            <small class="text-muted d-block">Đến hạn thu</small>
            <strong class="fs-5 text-primary"><%= format.currency(payableAmount) %></strong>
          </div>
          <form action="/billing" method="post" class="d-flex align-items-end gap-2 flex-wrap">
            <input type="hidden" name="admissionId" value="<%= row.admissionId %>">
            <div>
              <label class="form-label">Số tiền thanh toán</label>
              <input class="form-control" name="paidAmount" type="number" min="0" max="<%= payableAmount %>" value="<%= payableAmount %>">
            </div>
            <div>
              <label class="form-label">Phương thức</label>
              <select class="form-select" name="paymentMethod">
                <option>Tiền mặt</option>
                <option>Chuyển khoản</option>
                <option>Thẻ</option>
                <option>Ví điện tử</option>
              </select>
            </div>
            <input type="hidden" name="printAfterSave" value="1">
            <button class="btn btn-primary" <%= payableAmount > 0 ? '' : 'disabled' %>>
              <i class="bi bi-receipt me-2"></i>Lập phiếu thu
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
<% }) %>
